      "index.html": "<div id=\"news-root\" class=\"news\">\n<header class=\"news-masthead\">\n<h1 class=\"news-name\">News</h1>\n<p id=\"news-date\" class=\"news-date\"></p>\n</header>\n<nav id=\"news-tabs\" class=\"news-tabs\" aria-label=\"News sections\"></nav>\n<h2 id=\"news-title\" class=\"news-title\"></h2>\n<div id=\"news-status\" class=\"news-status\" aria-live=\"polite\"></div>\n<div id=\"news-body\"></div>\n</div>\n<style>\n.news { font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; color: #000; background: #fff; padding: 16px; }\n.news-masthead { border-bottom: 3px solid #000; padding: 0 0 8px 0; margin: 0 0 12px 0; }\n.news-name { font-size: 30px; line-height: 1.1; margin: 0; letter-spacing: 0.06em; text-transform: uppercase; }\n.news-date { font-size: 14px; margin: 6px 0 0 0; }\n.news-tabs { display: grid; grid-template-columns: repeat(3, 1fr); grid-gap: 8px; margin: 0 0 16px 0; }\n.news-tab { min-height: 48px; font-size: 16px; padding: 8px 4px; background: #fff; color: #000; border: 2px solid #000; }\n.news-tab-on { background: #000; color: #fff; font-weight: bold; }\n.news-title { font-size: 22px; margin: 0 0 4px 0; }\n.news-status { font-size: 16px; margin: 0 0 12px 0; min-height: 20px; }\n.news-list { list-style: none; margin: 0; padding: 0; }\n.news-item { border-top: 2px solid #000; padding: 12px 0 12px 0; }\n.news-headline { display: block; font-size: 19px; line-height: 1.3; font-weight: bold; color: #000; text-decoration: underline; overflow-wrap: break-word; }\n.news-headline-plain { text-decoration: none; }\n.news-summary { font-size: 16px; line-height: 1.4; margin: 6px 0 0 0; overflow-wrap: break-word; }\n.news-thumb { display: block; max-width: 240px; width: 100%; height: auto; margin: 10px 0 0 0; border: 1px solid #000; }\n.news-error { border: 2px solid #000; padding: 12px; }\n.news-error p { margin: 0 0 8px 0; font-size: 16px; line-height: 1.4; }\n.news-error-text { font-weight: bold; }\n.news-retry { min-height: 48px; font-size: 18px; padding: 12px 16px; background: #fff; color: #000; border: 2px solid #000; }\n</style>\n<script>\n(function () {\n  var MAX_ITEMS = 10;\n  var MAX_SUMMARY = 350;\n  var ERROR_TEXT = \"Could not fetch the wires for this section.\";\n  var HINT_TEXT = \"Check the connection, then tap Retry to reload this section.\";\n  var SECTIONS = [\n    { name: \"world\", label: \"World\", title: \"Top Headlines\" },\n    { name: \"technology\", label: \"Technology\", title: \"Technology Headlines\" },\n    { name: \"business\", label: \"Business\", title: \"Business Headlines\" },\n    { name: \"science\", label: \"Science\", title: \"Science Headlines\" },\n    { name: \"arts\", label: \"Arts\", title: \"Arts Headlines\" },\n    { name: \"finance\", label: \"Finance\", title: \"Finance Headlines\" }\n  ];\n  var root = document.getElementById(\"news-root\");\n  if (!root) { return; }\n  var dateEl = document.getElementById(\"news-date\");\n  var tabsEl = document.getElementById(\"news-tabs\");\n  var titleEl = document.getElementById(\"news-title\");\n  var statusEl = document.getElementById(\"news-status\");\n  var bodyEl = document.getElementById(\"news-body\");\n  var current = SECTIONS[0];\n  var requestSeq = 0;\n\n  function clearEl(el) {\n    while (el && el.firstChild) { el.removeChild(el.firstChild); }\n  }\n\n  function normalize(text) {\n    var raw = text === undefined || text === null ? \"\" : String(text);\n    var parts = raw.split(/\\s+/);\n    var out = [];\n    var i;\n    for (i = 0; i < parts.length; i++) {\n      if (parts[i] !== \"\") { out.push(parts[i]); }\n    }\n    return out.join(\" \");\n  }\n\n  function truncate(text) {\n    if (text.length <= MAX_SUMMARY) { return text; }\n    return text.slice(0, MAX_SUMMARY - 1) + \"…\";\n  }\n\n  function unescapeEntities(text) {\n    var out = text === undefined || text === null ? \"\" : String(text);\n    out = out.replace(/&#x([0-9a-fA-F]+);/g, function (match, code) {\n      return String.fromCharCode(parseInt(code, 16));\n    });\n    out = out.replace(/&#([0-9]+);/g, function (match, code) {\n      return String.fromCharCode(parseInt(code, 10));\n    });\n    out = out.replace(/&lt;/g, \"<\");\n    out = out.replace(/&gt;/g, \">\");\n    out = out.replace(/&quot;/g, \"\\\"\");\n    out = out.replace(/&apos;/g, \"'\");\n    out = out.replace(/&nbsp;/g, \" \");\n    out = out.replace(/&amp;/g, \"&\");\n    return out;\n  }\n\n  function dropTagged(container, name) {\n    var list = container.getElementsByTagName(name);\n    while (list.length > 0) {\n      var node = list[0];\n      if (node.parentNode) { node.parentNode.removeChild(node); }\n      else { break; }\n    }\n  }\n\n  /* Strip a feed-supplied description to plain text: markup, script and\n   * style never reach the list, only the text they wrap. */\n  function plainText(raw) {\n    if (!raw) { return \"\"; }\n    var text = \"\";\n    if (typeof DOMParser !== \"undefined\") {\n      var doc = null;\n      try { doc = new DOMParser().parseFromString(String(raw), \"text/html\"); }\n      catch (e) { doc = null; }\n      if (doc && doc.body) {\n        dropTagged(doc.body, \"script\");\n        dropTagged(doc.body, \"style\");\n        dropTagged(doc.body, \"iframe\");\n        text = doc.body.textContent || \"\";\n      }\n    }\n    if (text === \"\") {\n      text = unescapeEntities(String(raw).replace(/<[^>]*>/g, \" \"));\n    }\n    return normalize(text);\n  }\n\n  function childText(parent, tag) {\n    var i, node;\n    for (i = 0; i < parent.childNodes.length; i++) {\n      node = parent.childNodes[i];\n      if (node.nodeType === 1 && node.nodeName === tag) { return node.textContent || \"\"; }\n    }\n    return \"\";\n  }\n\n  function firstTag(parent, tag) {\n    var found = parent.getElementsByTagName(tag);\n    if (found && found.length > 0) { return found[0]; }\n    return null;\n  }\n\n  function looksLikeImage(url) {\n    return /\\.(jpg|jpeg|png|gif|webp)([?]|$)/i.test(url);\n  }\n\n  /* Absolute http(s) only: a feed link or thumbnail is never allowed to\n   * become javascript:, data:, or any other scheme. */\n  function safeUrl(url) {\n    if (!url) { return \"\"; }\n    var resolved = String(url);\n    try {\n      var base = typeof window !== \"undefined\" && window.location ? window.location.href : undefined;\n      resolved = new URL(String(url), base).href;\n    } catch (e) { resolved = String(url); }\n    if (resolved.indexOf(\"http://\") === 0 || resolved.indexOf(\"https://\") === 0) { return resolved; }\n    return \"\";\n  }\n\n  function thumbFromElement(el) {\n    var candidates = [];\n    var i, url, type, medium, node;\n    var thumb = firstTag(el, \"media:thumbnail\");\n    if (thumb) { candidates.push(thumb.getAttribute(\"url\") || \"\"); }\n    var contents = el.getElementsByTagName(\"media:content\");\n    for (i = 0; i < contents.length; i++) {\n      url = contents[i].getAttribute(\"url\") || \"\";\n      medium = contents[i].getAttribute(\"medium\") || \"\";\n      if (url !== \"\" && (medium === \"image\" || looksLikeImage(url))) { candidates.push(url); }\n    }\n    var enclosures = el.getElementsByTagName(\"enclosure\");\n    for (i = 0; i < enclosures.length; i++) {\n      url = enclosures[i].getAttribute(\"url\") || \"\";\n      type = enclosures[i].getAttribute(\"type\") || \"\";\n      if (url !== \"\" && type.indexOf(\"image/\") === 0) { candidates.push(url); }\n    }\n    for (i = 0; i < candidates.length; i++) {\n      var safe = safeUrl(candidates[i]);\n      if (safe !== \"\") { return safe; }\n    }\n    return \"\";\n  }\n\n  function thumbFromBlock(block) {\n    var m = /<media:thumbnail[^>]*url=[\"']([^\"']+)[\"']/i.exec(block);\n    if (m) { return safeUrl(m[1]); }\n    m = /<media:content[^>]*url=[\"']([^\"']+)[\"']/i.exec(block);\n    if (m && looksLikeImage(m[1])) { return safeUrl(m[1]); }\n    m = /<enclosure[^>]*url=[\"']([^\"']+)[\"']/i.exec(block);\n    if (m && looksLikeImage(m[1])) { return safeUrl(m[1]); }\n    return \"\";\n  }\n\n  function tagValue(block, re) {\n    var m = re.exec(block);\n    if (!m) { return \"\"; }\n    var v = m[1];\n    if (v.indexOf(\"<![CDATA[\") === 0) { v = v.slice(9); }\n    if (v.slice(-3) === \"]]>\") { v = v.slice(0, -3); }\n    return unescapeEntities(v);\n  }\n\n  function parseItemsRegex(text) {\n    var items = [];\n    var re = /<item>([\\s\\S]*?)<\\/item>/g;\n    var m;\n    while ((m = re.exec(text)) !== null) {\n      var block = m[1];\n      items.push({\n        title: tagValue(block, /<title[^>]*>([\\s\\S]*?)<\\/title>/i),\n        link: tagValue(block, /<link[^>]*>([\\s\\S]*?)<\\/link>/i),\n        description: tagValue(block, /<description[^>]*>([\\s\\S]*?)<\\/description>/i) || tagValue(block, /<content:encoded[^>]*>([\\s\\S]*?)<\\/content:encoded>/i),\n        thumb: thumbFromBlock(block)\n      });\n    }\n    return items.length > 0 ? items : null;\n  }\n\n  function parseItems(xmlText) {\n    var text = xmlText === undefined || xmlText === null ? \"\" : String(xmlText);\n    text = text.trim();\n    if (text === \"\") { return null; }\n    if (typeof DOMParser === \"undefined\") { return parseItemsRegex(text); }\n    var doc = null;\n    try { doc = new DOMParser().parseFromString(text, \"text/xml\"); }\n    catch (e) { doc = null; }\n    if (!doc) { return parseItemsRegex(text); }\n    var errs = doc.getElementsByTagName(\"parsererror\");\n    if (errs && errs.length > 0) { return parseItemsRegex(text); }\n    var itemEls = doc.getElementsByTagName(\"item\");\n    if (!itemEls || itemEls.length === 0) { return null; }\n    var items = [];\n    var i, el, desc;\n    for (i = 0; i < itemEls.length; i++) {\n      el = itemEls[i];\n      desc = childText(el, \"description\");\n      if (desc === \"\") { desc = childText(el, \"content:encoded\"); }\n      items.push({\n        title: childText(el, \"title\"),\n        link: childText(el, \"link\"),\n        description: desc,\n        thumb: thumbFromElement(el)\n      });\n    }\n    return items;\n  }\n\n  function formatDate(d) {\n    try {\n      return d.toLocaleDateString(undefined, { weekday: \"long\", month: \"long\", day: \"numeric\", year: \"numeric\" });\n    } catch (e) { return \"\"; }\n  }\n\n  /* Same-origin proxy only: the declared feed name, never a URL. */\n  function feedUrl(name) {\n    var base = \"\";\n    var el = root;\n    while (el) {\n      if (el.getAttribute) {\n        var attr = el.getAttribute(\"data-action-base\");\n        if (attr) { base = attr; break; }\n      }\n      el = el.parentNode;\n    }\n    if (base === \"\" && typeof window !== \"undefined\" && window.location) {\n      base = window.location.pathname || \"\";\n    }\n    var suffix = \"/apps/news\";\n    if (base.length > suffix.length && base.slice(base.length - suffix.length) === suffix) {\n      base = base.slice(0, base.length - suffix.length);\n    } else if (base === suffix) {\n      base = \"\";\n    } else {\n      var appsAt = base.indexOf(\"/apps/\");\n      base = appsAt !== -1 ? base.slice(0, appsAt) : \"\";\n    }\n    var url = base + \"/feed/news/\" + name;\n    if (typeof window !== \"undefined\" && window.location && window.location.search) {\n      var m = /(?:^|[?&])k=([^&]+)/.exec(window.location.search);\n      if (m) { url = url + \"?k=\" + encodeURIComponent(m[1]); }\n    }\n    return url;\n  }\n\n  function fetchText(url, onOk, onErr) {\n    if (typeof fetch === \"function\") {\n      fetch(url, { credentials: \"same-origin\" }).then(function (res) {\n        if (!res.ok) { throw new Error(\"HTTP \" + res.status); }\n        return res.text();\n      }).then(onOk).catch(onErr);\n      return;\n    }\n    if (typeof XMLHttpRequest !== \"undefined\") {\n      var xhr = new XMLHttpRequest();\n      xhr.open(\"GET\", url, true);\n      try { xhr.withCredentials = true; } catch (e) { /* no credentials support */ }\n      xhr.onreadystatechange = function () {\n        if (xhr.readyState === 4) {\n          if (xhr.status >= 200 && xhr.status < 300) { onOk(xhr.responseText); }\n          else { onErr(new Error(\"HTTP \" + xhr.status)); }\n        }\n      };\n      xhr.onerror = function () { onErr(new Error(\"Network error\")); };\n      try { xhr.send(); } catch (e) { onErr(e); }\n      return;\n    }\n    onErr(new Error(\"fetch unavailable\"));\n  }\n\n  function renderError() {\n    clearEl(bodyEl);\n    if (statusEl) { statusEl.textContent = \"\"; }\n    var box = document.createElement(\"div\");\n    box.className = \"news-error\";\n    var msg = document.createElement(\"p\");\n    msg.className = \"news-error-text\";\n    msg.textContent = ERROR_TEXT;\n    var hint = document.createElement(\"p\");\n    hint.className = \"news-error-hint\";\n    hint.textContent = HINT_TEXT;\n    var retry = document.createElement(\"button\");\n    retry.setAttribute(\"type\", \"button\");\n    retry.className = \"news-retry\";\n    retry.textContent = \"Retry\";\n    retry.addEventListener(\"click\", function () { load(current); });\n    box.appendChild(msg);\n    box.appendChild(hint);\n    box.appendChild(retry);\n    bodyEl.appendChild(box);\n  }\n\n  function renderItems(items) {\n    clearEl(bodyEl);\n    if (statusEl) { statusEl.textContent = \"\"; }\n    var list = document.createElement(\"ol\");\n    list.className = \"news-list\";\n    var count = items.length < MAX_ITEMS ? items.length : MAX_ITEMS;\n    var i;\n    for (i = 0; i < count; i++) {\n      var item = items[i];\n      var li = document.createElement(\"li\");\n      li.className = \"news-item\";\n      var titleText = normalize(item.title);\n      if (titleText === \"\") { titleText = \"Untitled story\"; }\n      var link = safeUrl(item.link);\n      var head;\n      if (link !== \"\") {\n        head = document.createElement(\"a\");\n        head.className = \"news-headline\";\n        head.setAttribute(\"href\", link);\n        head.setAttribute(\"target\", \"_blank\");\n        head.setAttribute(\"rel\", \"noopener noreferrer\");\n      } else {\n        head = document.createElement(\"span\");\n        head.className = \"news-headline news-headline-plain\";\n      }\n      head.textContent = titleText;\n      li.appendChild(head);\n      var summaryText = truncate(plainText(item.description));\n      if (summaryText !== \"\") {\n        var summary = document.createElement(\"p\");\n        summary.className = \"news-summary\";\n        summary.textContent = summaryText;\n        li.appendChild(summary);\n      }\n      if (item.thumb) {\n        var img = document.createElement(\"img\");\n        img.className = \"news-thumb\";\n        img.setAttribute(\"src\", item.thumb);\n        img.setAttribute(\"alt\", titleText);\n        li.appendChild(img);\n      }\n      list.appendChild(li);\n    }\n    bodyEl.appendChild(list);\n  }\n\n  function load(section) {\n    requestSeq = requestSeq + 1;\n    var seq = requestSeq;\n    /* Clear first: the previous section must never read as current while\n     * this one is still in flight. */\n    clearEl(bodyEl);\n    if (statusEl) { statusEl.textContent = \"Fetching \" + section.label + \" headlines…\"; }\n    fetchText(feedUrl(section.name), function (xml) {\n      if (seq !== requestSeq) { return; }\n      var items = parseItems(xml);\n      if (!items || items.length === 0) { renderError(); return; }\n      renderItems(items);\n    }, function () {\n      if (seq !== requestSeq) { return; }\n      renderError();\n    });\n  }\n\n  function select(section) {\n    current = section;\n    if (titleEl) { titleEl.textContent = section.title; }\n    renderTabs();\n    load(section);\n  }\n\n  function renderTabs() {\n    if (!tabsEl) { return; }\n    clearEl(tabsEl);\n    var i;\n    for (i = 0; i < SECTIONS.length; i++) {\n      tabsEl.appendChild(makeTab(SECTIONS[i]));\n    }\n  }\n\n  function makeTab(section) {\n    var btn = document.createElement(\"button\");\n    btn.setAttribute(\"type\", \"button\");\n    var active = section.name === current.name;\n    btn.className = active ? \"news-tab news-tab-on\" : \"news-tab\";\n    btn.setAttribute(\"aria-pressed\", active ? \"true\" : \"false\");\n    btn.textContent = section.label;\n    btn.addEventListener(\"click\", function () { select(section); });\n    return btn;\n  }\n\n  function init() {\n    if (!tabsEl || !titleEl || !statusEl || !bodyEl) { return; }\n    if (dateEl) { dateEl.textContent = formatDate(new Date()); }\n    if (titleEl) { titleEl.textContent = current.title; }\n    renderTabs();\n    load(current);\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", init);\n  } else {\n    init();\n  }\n})();\n</script>\n"
    }
  },
