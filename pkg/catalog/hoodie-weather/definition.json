        "type": "integer",
        "min": -90000000,
        "max": 90000000
      },
      "lon": {
        "type": "integer",
        "min": -180000000,
        "max": 180000000
      },
      "label": {
        "type": "string",
        "maxLength": 80
      }
    }
  },
  "actions": {
    "set_location": {
      "description": "Save a place for weather. lat and lon are integer microdegrees (decimal degrees * 1,000,000).",
      "args": {
