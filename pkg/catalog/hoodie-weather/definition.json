    "files": {
      "index.html": "<div class=\"hw\">\n  <div class=\"hw-main\">\n    <div class=\"hw-readout\">\n      <p class=\"hw-label\" id=\"hw-label\">Seattle, WA</p>\n      <div class=\"hw-temp-line\">\n        <p class=\"hw-temp\" id=\"hw-temp\">--</p>\n        <p class=\"hw-cond\" id=\"hw-cond\">Loading forecast...</p>\n      </div>\n      <p class=\"hw-rain\" id=\"hw-rain\"></p>\n    </div>\n    <div class=\"hw-verdicts\" id=\"hw-verdicts\">\n    <div class=\"hw-verdict\" data-verdict=\"raincoat\" hidden>\n      <img src=\"data:image/png;base64,\" alt=\"Raincoat\" width=\"128\" height=\"128\" />\n    </div>\n    <div class=\"hw-verdict\" data-verdict=\"jacket\" hidden>\n      <img src=\"data:image/png;base64,\" alt=\"Jacket\" width=\"128\" height=\"128\" />\n    </div>\n    <div class=\"hw-verdict\" data-verdict=\"hoodie\" hidden>\n      <img src=\"data:image/png;base64,\" alt=\"Hoodie\" width=\"128\" height=\"128\" />\n    </div>\n    <div class=\"hw-verdict\" data-verdict=\"tshirt\" hidden>\n      <img src=\"data:image/png;base64,\" alt=\"T-shirt\" width=\"128\" height=\"128\" />\n    </div>\n    </div>\n  </div>\n  <p class=\"hw-status\" id=\"hw-status\" role=\"status\"></p>\n  <p class=\"hw-error\" id=\"hw-error\" role=\"alert\" hidden></p>\n  <p class=\"hw-notice\" id=\"hw-notice\" hidden></p>\n  <div class=\"hw-actions\">\n    <button class=\"hw-btn\" id=\"hw-refresh\" type=\"button\">Refresh</button>\n    <button class=\"hw-btn\" id=\"hw-retry\" type=\"button\" hidden>Retry</button>\n    <button class=\"hw-btn\" id=\"hw-search-toggle\" type=\"button\">Change place</button>\n  </div>\n  <div class=\"hw-search\" id=\"hw-search\" hidden>\n    <label class=\"hw-search-label\" for=\"hw-query\">Search for a city</label>\n    <input id=\"hw-query\" type=\"search\" autocomplete=\"off\" maxlength=\"80\" />\n    <p class=\"hw-search-status\" id=\"hw-search-status\"></p>\n    <ul class=\"hw-results\" id=\"hw-results\"></ul>\n  </div>\n  <p class=\"hw-note\">A kody-os rewrite of <a href=\"https://github.com/Hypercubed/HoodieWeather\" target=\"_blank\" rel=\"noopener\">Hypercubed/HoodieWeather</a> on GitHub.</p>\n</div>\n<style>\n.hw { padding: 16px; max-width: 420px; margin: 0 auto; }\n.hw-main { display: grid; grid-template-columns: 1fr 96px; gap: 12px; align-items: center; margin: 0 0 8px 0; }\n.hw-readout { min-width: 0; }\n.hw-label { font-size: 20px; font-weight: bold; margin: 0 0 2px 0; overflow-wrap: break-word; }\n.hw-temp-line { display: grid; grid-template-columns: auto 1fr; gap: 8px; align-items: baseline; margin: 0 0 2px 0; }\n.hw-temp { font-size: 31px; line-height: 1.1; margin: 0; font-variant-numeric: tabular-nums; }\n.hw-cond { font-size: 31px; margin: 0; }\n.hw-rain { font-size: 16px; margin: 0; }\n.hw-verdicts { margin: 0; }\n.hw-verdict { margin: 0; }\n.hw-verdict[hidden] { display: none; }\n.hw-verdict img { display: block; margin: 0; width: 96px; height: 96px; }\n.hw-status { font-size: 16px; margin: 8px 0; min-height: 20px; }\n.hw-error, .hw-notice { border: 2px solid #000; padding: 12px; font-size: 16px; margin: 8px 0; overflow-wrap: break-word; }\n.hw-error[hidden], .hw-notice[hidden], .hw-search[hidden] { display: none; }\n.hw-actions { display: grid; grid-template-columns: 1fr 1fr; grid-gap: 8px; gap: 8px; margin: 12px 0 0 0; }\n\n.hw-btn[hidden] { display: none; }\n\n.hw-search { margin: 12px 0 0 0; border-top: 2px solid #000; padding: 12px 0 0 0; }\n.hw-search-label { display: block; font-size: 16px; margin: 0 0 6px 0; }\n.hw-search input { width: 100%; }\n.hw-search-status { font-size: 15px; margin: 8px 0; min-height: 18px; }\n.hw-results { list-style: none; margin: 0; padding: 0; }\n.hw-results li { margin: 0 0 8px 0; }\n.hw-results button { display: block; width: 100%; text-align: left; }\n\n.hw-results button small { display: block; font-size: 14px; margin: 2px 0 0 0; }\n.hw-note { font-size: 13px; color: #444; margin: 12px 0 0 0; }\nsection.widget[data-app-id=\"hoodie-weather\"] .app-body { flex: 1; display: flex; flex-direction: column; justify-content: center; min-height: 8rem; }\nsection.widget .hw-btn, section.widget .hw-note { display: none; }\n</style>\n<script>\nvar hwScriptEl = null;\ntry { hwScriptEl = document.currentScript; } catch (err) { hwScriptEl = null; }\nvar hwSectionEl = null;\n(function () {\n  var el = hwScriptEl;\n  while (el) {\n    if (el.getAttribute && el.getAttribute('data-app-id')) { hwSectionEl = el; break; }\n    el = el.parentNode;\n  }\n  if (!hwSectionEl) {\n    var sections = document.querySelectorAll('section[data-app-id]');\n    if (sections.length > 0) { hwSectionEl = sections[0]; }\n  }\n})();\nvar HW_DEFAULT = { lat: 47606200, lon: -122332100, label: 'Seattle, WA' };\nvar HW_FEED_NAME = 'default';\nvar HW_TIMEOUT_MS = 8000;\nvar HW_NAME_TIMEOUT_MS = 5000;\nvar HW_GEO_TIMEOUT_MS = 8000;\nvar hwStore = null;\nvar hwPlace = { lat: HW_DEFAULT.lat, lon: HW_DEFAULT.lon, label: HW_DEFAULT.label };\nvar hwLastKey = '';\nvar hwLoadSeq = 0;\nvar hwInitialized = false;\nvar hwGeoTried = false;\nvar hwSnapshotTimer = null;\nvar hwSearchTimer = null;\nvar hwSearchRequest = 0;\n\nfunction hwEl(id) {\n  var root = hwSectionEl && hwSectionEl.querySelector ? hwSectionEl : document;\n  return root.querySelector('#' + id);\n}\nfunction hwQueryAll(selector) {\n  var root = hwSectionEl && hwSectionEl.querySelectorAll ? hwSectionEl : document;\n  return root.querySelectorAll(selector);\n}\nfunction hwSetText(id, value) {\n  var el = hwEl(id);\n  if (el) { el.textContent = value; }\n}\nfunction hwNum(value) {\n  return (typeof value === 'number' && isFinite(value)) ? value : null;\n}\nfunction hwRound(value) {\n  return Math.round(value);\n}\nfunction hwPlaceKey(place) {\n  return String(place.lat) + ',' + String(place.lon);\n}\nfunction hwIsDefault(place) {\n  return place.lat === HW_DEFAULT.lat && place.lon === HW_DEFAULT.lon;\n}\nfunction hwActionBase() {\n  if (hwSectionEl && hwSectionEl.querySelector) {\n    var bundle = hwSectionEl.querySelector('.bundle');\n    if (bundle && bundle.getAttribute) {\n      var base = bundle.getAttribute('data-action-base');\n      if (base) { return base; }\n    }\n  }\n  var path = (typeof window !== 'undefined' && window.location && window.location.pathname) ? window.location.pathname : '';\n  var at = path.indexOf('/apps/');\n  if (at !== -1) {\n    var rest = path.slice(at + 6);\n    var slash = rest.indexOf('/');\n    var id = slash === -1 ? rest : rest.slice(0, slash);\n    if (id) { return path.slice(0, at) + '/apps/' + id; }\n  }\n  return '/apps/hoodie-weather';\n}\nfunction hwOriginPrefix() {\n  var base = hwActionBase();\n  var at = base.lastIndexOf('/apps/');\n  return at === -1 ? '' : base.slice(0, at);\n}\nfunction hwQuerySuffix() {\n  var key = '';\n  try {\n    var match = /[?&]k=([^&]+)/.exec(window.location.search || '');\n    if (match) { key = match[1]; }\n  } catch (err) { key = ''; }\n  if (!key && hwSectionEl && hwSectionEl.querySelector) {\n    var input = hwSectionEl.querySelector('input[name=\"k\"]');\n    if (input && input.value) { key = input.value; }\n  }\n  return key ? ('?k=' + encodeURIComponent(key)) : '';\n}\nfunction hwFeedUrl() {\n  return hwOriginPrefix() + '/feed/hoodie-weather/' + HW_FEED_NAME + hwQuerySuffix();\n}\nfunction hwFixedDegrees(micro) {\n  return (micro / 1000000).toFixed(4);\n}\nfunction hwWeatherUrl(place) {\n  return 'https://api.open-meteo.com/v1/forecast?latitude=' + hwFixedDegrees(place.lat) +\n    '&longitude=' + hwFixedDegrees(place.lon) +\n    '&current=temperature_2m,apparent_temperature,weather_code,wind_speed_10m' +\n    '&hourly=temperature_2m,apparent_temperature,precipitation_probability,weather_code,wind_speed_10m' +\n    '&forecast_days=1&timezone=auto&temperature_unit=fahrenheit&wind_speed_unit=mph';\n}\nfunction hwNwsPointsUrl(place) {\n  return 'https://api.weather.gov/points/' + hwFixedDegrees(place.lat) + ',' + hwFixedDegrees(place.lon);\n}\nfunction hwGeocodeUrl(query) {\n  return 'https://geocoding-api.open-meteo.com/v1/search?name=' + encodeURIComponent(query) + '&count=6&language=en&format=json';\n}\nfunction hwFetchText(url, opts, timeoutMs) {\n  return new Promise(function (resolve, reject) {\n    if (typeof fetch !== 'function') { reject(new Error('fetch unavailable')); return; }\n    var finished = false;\n    var timer = setTimeout(function () {\n      if (finished) { return; }\n      finished = true;\n      reject(new Error('timed out'));\n    }, timeoutMs);\n    function done(err, value) {\n      if (finished) { return; }\n      finished = true;\n      clearTimeout(timer);\n      if (err) { reject(err); } else { resolve(value); }\n    }\n    var result;\n    try {\n      result = fetch(url, opts || {});\n    } catch (err) { done(err); return; }\n    if (!result || typeof result.then !== 'function') { done(new Error('fetch failed')); return; }\n    result.then(function (response) {\n      if (!response || !response.ok) { done(new Error('HTTP ' + (response ? response.status : 'error'))); return; }\n      return response.text().then(function (body) { done(null, body); }, function (err) { done(err); });\n    }, function (err) { done(err); });\n  });\n}\nfunction hwFetchJson(url, opts, timeoutMs) {\n  return hwFetchText(url, opts, timeoutMs).then(function (body) {\n    var data;\n    try { data = JSON.parse(body); } catch (err) { throw new Error('bad JSON'); }\n    return data;\n  });\n}\nfunction hwLocalNowKey(timezone, fallback) {\n  try {\n    if (typeof Intl !== 'undefined' && Intl.DateTimeFormat && timezone) {\n      var fmt = new Intl.DateTimeFormat('en-CA', { timeZone: timezone, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false });\n      var parts = fmt.formatToParts(new Date());\n      var got = {};\n      for (var i = 0; i < parts.length; i++) { got[parts[i].type] = parts[i].value; }\n      var hour = got.hour === '24' ? '00' : got.hour;\n      return got.year + '-' + got.month + '-' + got.day + 'T' + hour + ':' + got.minute;\n    }\n  } catch (err) { /* fall through */ }\n  if (typeof fallback === 'string' && fallback.length >= 16) { return fallback.slice(0, 16); }\n  return '';\n}\nfunction hwVerdict(rainPct, apparentF) {\n  var rain = hwNum(rainPct);\n  var apparent = hwNum(apparentF);\n  if (rain === null) { rain = 0; }\n  if (apparent === null) { apparent = 0; }\n  if (rain > 30) { return 'raincoat'; }\n  if (apparent < 51) { return 'jacket'; }\n  if (apparent < 65) { return 'hoodie'; }\n  return 'tshirt';\n}\nfunction hwWindChill(tempF, windMph) {\n  var temp = hwNum(tempF);\n  var wind = hwNum(windMph);\n  if (temp === null) { return null; }\n  if (wind === null || wind <= 3) { return temp; }\n  var power = Math.pow(wind, 0.16);\n  return 35.74 + 0.6215 * temp - 35.75 * power + 0.4275 * temp * power;\n}\nfunction hwConditions(code) {\n  var c = hwNum(code);\n  if (c === null) { return 'Conditions unavailable'; }\n  if (c === 0) { return 'Clear'; }\n  if (c === 1) { return 'Mainly clear'; }\n  if (c === 2) { return 'Partly cloudy'; }\n  if (c === 3) { return 'Overcast'; }\n  if (c === 45 || c === 48) { return 'Fog'; }\n  if (c === 51 || c === 53 || c === 55) { return 'Drizzle'; }\n  if (c === 56 || c === 57) { return 'Freezing drizzle'; }\n  if (c === 61 || c === 63 || c === 65) { return 'Rain'; }\n  if (c === 66 || c === 67) { return 'Freezing rain'; }\n  if (c === 71 || c === 73 || c === 75) { return 'Snow'; }\n  if (c === 77) { return 'Snow grains'; }\n  if (c === 80 || c === 81 || c === 82) { return 'Showers'; }\n  if (c === 85 || c === 86) { return 'Snow showers'; }\n  if (c === 95) { return 'Thunderstorm'; }\n  if (c === 96 || c === 99) { return 'Thunderstorm with hail'; }\n  return 'Cloudy';\n}\nfunction hwHourlyAt(hourly, index, key) {\n  if (!hourly || !hourly[key] || index === null) { return null; }\n  return hwNum(hourly[key][index]);\n}\nfunction hwExtract(data) {\n  if (!data || typeof data !== 'object') { return null; }\n  var hourly = data.hourly ? data.hourly : null;\n  var current = data.current ? data.current : {};\n  var index = null;\n  if (hourly && hourly.time && hourly.time.length > 0) {\n    var nowKey = hwLocalNowKey(data.timezone, current.time);\n    for (var i = 0; i < hourly.time.length; i++) {\n      if (String(hourly.time[i]) >= nowKey) { index = i; break; }\n    }\n    if (index === null) { index = hourly.time.length - 1; }\n  }\n  var temp = hwHourlyAt(hourly, index, 'temperature_2m');\n  if (temp === null) { temp = hwNum(current.temperature_2m); }\n  var apparent = hwHourlyAt(hourly, index, 'apparent_temperature');\n  if (apparent === null) { apparent = hwNum(current.apparent_temperature); }\n  var wind = hwHourlyAt(hourly, index, 'wind_speed_10m');\n  if (wind === null) { wind = hwNum(current.wind_speed_10m); }\n  if (apparent === null) { apparent = hwWindChill(temp, wind); }\n  var rain = hwHourlyAt(hourly, index, 'precipitation_probability');\n  if (rain === null) { rain = 0; }\n  var code = hwHourlyAt(hourly, index, 'weather_code');\n  if (code === null) { code = hwNum(current.weather_code); }\n  if (temp === null) { return null; }\n  return { temp: temp, apparent: apparent === null ? temp : apparent, rain: rain, code: code };\n}\nfunction hwNwsPlaceLabel(meta, fallback) {\n  var props = meta && meta.properties ? meta.properties : null;\n  var rel = props && props.relativeLocation ? props.relativeLocation.properties : null;\n  if (!rel) { return fallback; }\n  var city = (typeof rel.city === 'string' && rel.city !== '') ? rel.city : '';\n  var state = (typeof rel.state === 'string' && rel.state !== '') ? rel.state : '';\n  var label = city && state ? city + ', ' + state : (city || state);\n  if (label === '') { return fallback; }\n  if (label.length > 80) { label = label.slice(0, 80); }\n  return label;\n}\nfunction hwHideVerdicts() {\n  var rows = hwQueryAll('.hw-verdict');\n  for (var i = 0; i < rows.length; i++) { rows[i].hidden = true; }\n}\nfunction hwShowVerdict(name) {\n  hwHideVerdicts();\n  var rows = hwQueryAll('.hw-verdict');\n  for (var i = 0; i < rows.length; i++) {\n    if (rows[i].getAttribute('data-verdict') === name) { rows[i].hidden = false; }\n  }\n}\nfunction hwNotice(message) {\n  var el = hwEl('hw-notice');\n  if (el) {\n    if (message) { el.textContent = message; el.hidden = false; }\n    else { el.textContent = ''; el.hidden = true; }\n  }\n  var retry = hwEl('hw-retry');\n  if (retry) { retry.hidden = !message; }\n}\nfunction hwShowLoading() {\n  hwSetText('hw-status', 'Loading forecast...');\n  hwSetText('hw-temp', '--');\n  hwSetText('hw-cond', '');\n  hwSetText('hw-rain', '');\n  var err = hwEl('hw-error');\n  if (err) { err.hidden = true; err.textContent = ''; }\n  hwHideVerdicts();\n}\nfunction hwShowError(message) {\n  hwHideVerdicts();\n  hwSetText('hw-temp', '--');\n  hwSetText('hw-cond', '');\n  hwSetText('hw-rain', '');\n  hwSetText('hw-status', '');\n  var err = hwEl('hw-error');\n  if (err) { err.textContent = message; err.hidden = false; }\n  hwNotice('');\n  var retry = hwEl('hw-retry');\n  if (retry) { retry.hidden = false; }\n}\nfunction hwPaint(weather, label, notice) {\n  hwSetText('hw-label', label);\n  hwSetText('hw-temp', hwRound(weather.temp) + '\\u00B0F');\n  var cond = (typeof weather.cond === 'string' && weather.cond !== '') ? weather.cond : hwConditions(weather.code);\n  hwSetText('hw-cond', cond);\n  hwSetText('hw-rain', 'Rain ' + hwRound(weather.rain) + '%');\n  hwSetText('hw-status', '');\n  var err = hwEl('hw-error');\n  if (err) { err.hidden = true; err.textContent = ''; }\n  hwNotice(notice ? notice : '');\n  hwShowVerdict(hwVerdict(weather.rain, weather.apparent));\n}\nfunction hwLoadDefault(seq, notice) {\n  hwShowLoading();\n  hwFetchJson(hwFeedUrl(), { credentials: 'same-origin' }, HW_TIMEOUT_MS).then(function (data) {\n    if (seq !== hwLoadSeq) { return; }\n    var weather = hwExtract(data);\n    if (!weather) { hwShowError('The default forecast was empty.'); return; }\n    hwPaint(weather, HW_DEFAULT.label, notice);\n  }, function () {\n    if (seq !== hwLoadSeq) { return; }\n    hwShowError('Could not load the default forecast.');\n  });\n}\nfunction hwLoadFallback(seq, place) {\n  hwFetchJson(hwFeedUrl(), { credentials: 'same-origin' }, HW_TIMEOUT_MS).then(function (data) {\n    if (seq !== hwLoadSeq) { return; }\n    var weather = hwExtract(data);\n    if (!weather) { hwShowError('The default forecast was empty.'); return; }\n    hwPaint(weather, HW_DEFAULT.label);\n    hwNotice('Could not reach ' + place.label + '. Showing ' + HW_DEFAULT.label + '.');\n  }, function () {\n    if (seq !== hwLoadSeq) { return; }\n    hwShowError('Could not load the forecast.');\n  });\n}\nfunction hwLoadSavedDirect(seq, place, notice) {\n  hwFetchJson(hwWeatherUrl(place), { credentials: 'omit' }, HW_TIMEOUT_MS).then(function (data) {\n    if (seq !== hwLoadSeq) { return; }\n    var weather = hwExtract(data);\n    if (!weather) { hwLoadFallback(seq, place); return; }\n    hwPaint(weather, place.label, notice);\n  }, function () {\n    if (seq !== hwLoadSeq) { return; }\n    hwLoadFallback(seq, place);\n  });\n}\nfunction hwLoadSaved(place) {\n  var seq = hwLoadSeq + 1;\n  hwLoadSeq = seq;\n  hwShowLoading();\n  hwLoadSavedDirect(seq, place, '');\n}\nfunction hwStartDefault() {\n  hwStartForPlace(hwPlace);\n}\nfunction hwStartForPlace(place) {\n  var seq = hwLoadSeq + 1;\n  hwLoadSeq = seq;\n  hwNotice('');\n  if (hwIsDefault(place)) {\n    hwLoadDefault(seq);\n  } else {\n    hwShowLoading();\n    hwLoadSavedDirect(seq, place, '');\n  }\n  if (place.label === 'Current location') { hwNamePlace(seq, place); }\n}\nfunction hwNamePlace(seq, place) {\n  hwFetchJson(hwNwsPointsUrl(place), { credentials: 'omit' }, HW_NAME_TIMEOUT_MS).then(function (meta) {\n    if (seq !== hwLoadSeq) { return; }\n    if (hwPlace.lat !== place.lat || hwPlace.lon !== place.lon) { return; }\n    var better = hwNwsPlaceLabel(meta, place.label);\n    if (better === place.label) { return; }\n    place.label = better;\n    hwAdoptPlaceLabel(place.lat, place.lon, better);\n  }, function () { /* naming is enhance-only */ });\n}\nfunction hwPlaceFromStore() {\n  var lat = hwStore ? hwStore.get('lat') : hwPlace.lat;\n  var lon = hwStore ? hwStore.get('lon') : hwPlace.lon;\n  var label = hwStore ? hwStore.get('label') : hwPlace.label;\n  if (typeof lat !== 'number') { lat = HW_DEFAULT.lat; }\n  if (typeof lon !== 'number') { lon = HW_DEFAULT.lon; }\n  if (typeof label !== 'string' || label === '') { label = HW_DEFAULT.label; }\n  return { lat: lat, lon: lon, label: label };\n}\nfunction hwOnSnapshot(snap) {\n  var next = { lat: snap.desired.lat, lon: snap.desired.lon, label: snap.desired.label };\n  if (typeof next.lat !== 'number') { next.lat = HW_DEFAULT.lat; }\n  if (typeof next.lon !== 'number') { next.lon = HW_DEFAULT.lon; }\n  if (typeof next.label !== 'string' || next.label === '') { next.label = HW_DEFAULT.label; }\n  hwPlace = next;\n  var nextKey = hwPlaceKey(hwPlace);\n  if (nextKey === hwLastKey) { return; }\n  if (hwSnapshotTimer !== null) { clearTimeout(hwSnapshotTimer); }\n  hwSnapshotTimer = setTimeout(function () {\n    hwSnapshotTimer = null;\n    var key = hwPlaceKey(hwPlace);\n    if (key === hwLastKey) { return; }\n    hwLastKey = key;\n    hwStartForPlace(hwPlace);\n  }, 40);\n}\nfunction hwSetPlace(lat, lon, label) {\n  if (typeof lat !== 'number' || typeof lon !== 'number' || lat < -90000000 || lat > 90000000 || lon < -180000000 || lon > 180000000) { return; }\n  if (typeof label !== 'string' || label === '') { label = 'Selected place'; }\n  if (label.length > 80) { label = label.slice(0, 80); }\n  var place = { lat: lat, lon: lon, label: label };\n  if (hwStore) {\n    hwStore.dispatch('set_location', { lat: lat, lon: lon, label: label }, { lat: lat, lon: lon, label: label }, null);\n    return;\n  }\n  hwPlace = place;\n  hwLastKey = hwPlaceKey(place);\n  hwSetText('hw-label', label);\n  hwStartForPlace(place);\n}\nfunction hwAdoptPlaceLabel(lat, lon, label) {\n  hwPlace = { lat: lat, lon: lon, label: label };\n  hwSetText('hw-label', label);\n  if (hwStore) {\n    hwStore.dispatch('set_location', { lat: lat, lon: lon, label: label }, { lat: lat, lon: lon, label: label }, null);\n  }\n}\nfunction hwRefresh() {\n  if (hwSnapshotTimer !== null) { clearTimeout(hwSnapshotTimer); hwSnapshotTimer = null; }\n  hwLastKey = hwPlaceKey(hwPlace);\n  hwStartForPlace(hwPlace);\n}\nfunction hwRetry() {\n  hwStartForPlace(hwPlace);\n}\nfunction hwIsWidget() { if (!hwSectionEl) { return false; } var cls = ''; try { cls = hwSectionEl.className || ''; } catch (err) { cls = ''; } return cls.indexOf('widget') !== -1; } function hwClaimRestoreForm() {\n  if (!hwStore || !hwSectionEl || !hwSectionEl.querySelectorAll) { return; }\n  var forms = hwSectionEl.querySelectorAll('form.app-action');\n  for (var i = 0; i < forms.length; i++) {\n    var input = forms[i].querySelector('input[name=\"action\"]');\n    if (input && input.value === 'restore_default') {\n      hwStore.claimForm(forms[i], 'restore_default', function () { return {}; }, null); if (hwIsWidget() && forms[i].style) { forms[i].style.display = 'none'; }\n    }\n  }\n}\nfunction hwResultPlace(result) {\n  if (!result) { return null; }\n  var lat = hwNum(result.latitude);\n  var lon = hwNum(result.longitude);\n  if (lat === null || lon === null) { return null; }\n  if (lat < -90 || lat > 90 || lon < -180 || lon > 180) { return null; }\n  var name = (typeof result.name === 'string' && result.name !== '') ? result.name : 'Selected place';\n  var detail = '';\n  if (typeof result.admin1 === 'string' && result.admin1 !== '') { detail = result.admin1; }\n  if (typeof result.country === 'string' && result.country !== '') { detail = detail ? detail + ', ' + result.country : result.country; }\n  var label = name + (detail ? ', ' + detail : '');\n  if (label.length > 80) { label = label.slice(0, 80); }\n  return { lat: Math.round(lat * 1000000), lon