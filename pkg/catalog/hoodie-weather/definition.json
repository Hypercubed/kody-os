  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 5 3 8l2.5 4L8 10.5V19h8v-8.5l2.5 1.5L21 8l-5-3\" /><path d=\"M9 5c1-2 5-2 6 0\" /><path d=\"M10 14h4v3h-4z\" /></svg>",
  "category": "weather",
