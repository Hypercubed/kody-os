{
  "id": "settings",
  "name": "Settings",
  "label": "Settings",
  "schemaVersion": 5,
  "catalogVersion": 2,
  "icon": "⚙",
  "category": "utilities",
  "description": "Change the shell theme from the browser: name, title, icon, and background.",
  "capabilities": {
    "theme": {
      "view": true,
      "set": true
    }
  },
  "bundle": {
    "entry": "index.html",
    "files": {
      "index.html": "<div class=\"st\">\n<p id=\"st-status\">Loading the shell theme…</p>\n<div id=\"st-panel\" style=\"display:none\">\n<div class=\"st-field\">\n<h3>Background</h3>\n<p>Current: <span id=\"st-background-value\">…</span> (<span id=\"st-background-source\">…</span>)</p>\n<p id=\"st-background-note\" class=\"st-note\" style=\"display:none\">Custom grid, set via file or agent. Choose desk or paper below to replace it.</p>\n<div class=\"st-forms\">\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"set\">\n<input type=\"hidden\" name=\"background\" value=\"desk\">\n<button type=\"submit\">Desk</button>\n</form>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"set\">\n<input type=\"hidden\" name=\"background\" value=\"paper\">\n<button type=\"submit\">Paper</button>\n</form>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"reset\">\n<input type=\"hidden\" name=\"field\" value=\"background\">\n<button type=\"submit\">Reset background</button>\n</form>\n</div>\n</div>\n<div class=\"st-field\">\n<h3>Name</h3>\n<p>Current: <span id=\"st-name-value\">…</span> (<span id=\"st-name-source\">…</span>)</p>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"set\">\n<label>New name <input type=\"text\" name=\"name\" id=\"st-name-input\" value=\"\" maxlength=\"200\"></label>\n<button type=\"submit\">Set name</button>\n</form>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"reset\">\n<input type=\"hidden\" name=\"field\" value=\"name\">\n<button type=\"submit\">Reset name</button>\n</form>\n</div>\n<div class=\"st-field\">\n<h3>Title</h3>\n<p>Current: <span id=\"st-title-value\">…</span> (<span id=\"st-title-source\">…</span>)</p>\n<p class=\"st-note\">Blank clears the title; the shell then shows the name.</p>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"set\">\n<label>New title <input type=\"text\" name=\"title\" id=\"st-title-input\" value=\"\"></label>\n<button type=\"submit\">Set title</button>\n</form>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"reset\">\n<input type=\"hidden\" name=\"field\" value=\"title\">\n<button type=\"submit\">Reset title</button>\n</form>\n</div>\n<div class=\"st-field\">\n<h3>Icon</h3>\n<p>Current: <span id=\"st-icon-value\">…</span> (<span id=\"st-icon-source\">…</span>)</p>\n<p id=\"st-icon-note\" class=\"st-note\" style=\"display:none\">Custom mark, set via file or agent. Type a glyph below, or use the stock mark, to replace it.</p>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"set\">\n<label>Glyph <input type=\"text\" name=\"icon\" id=\"st-icon-input\" value=\"\"></label>\n<button type=\"submit\">Set icon</button>\n</form>\n<div class=\"st-forms\">\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"set\">\n<input type=\"hidden\" name=\"icon\" value=\"\">\n<button type=\"submit\">Stock mark</button>\n</form>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"reset\">\n<input type=\"hidden\" name=\"field\" value=\"icon\">\n<button type=\"submit\">Reset icon</button>\n</form>\n</div>\n</div>\n<div class=\"st-field\">\n<h3>Pages</h3>\n<p>Help: <span id=\"st-showHelp-value\">…</span> (<span id=\"st-showHelp-source\">…</span>)</p>\n<div class=\"st-forms\">\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"set\">\n<input type=\"hidden\" name=\"showHelp\" value=\"1\">\n<button type=\"submit\">Show Help</button>\n</form>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"set\">\n<input type=\"hidden\" name=\"showHelp\" value=\"0\">\n<button type=\"submit\">Hide Help</button>\n</form>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"reset\">\n<input type=\"hidden\" name=\"field\" value=\"showHelp\">\n<button type=\"submit\">Reset Help</button>\n</form>\n</div>\n<p>About: <span id=\"st-showAbout-value\">…</span> (<span id=\"st-showAbout-source\">…</span>)</p>\n<div class=\"st-forms\">\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"set\">\n<input type=\"hidden\" name=\"showAbout\" value=\"1\">\n<button type=\"submit\">Show About</button>\n</form>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"set\">\n<input type=\"hidden\" name=\"showAbout\" value=\"0\">\n<button type=\"submit\">Hide About</button>\n</form>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"reset\">\n<input type=\"hidden\" name=\"field\" value=\"showAbout\">\n<button type=\"submit\">Reset About</button>\n</form>\n</div>\n</div>\n<div class=\"st-field\">\n<h3>Reset all</h3>\n<form method=\"get\" action=\"../theme/settings\">\n<input type=\"hidden\" name=\"action\" value=\"reset\">\n<button type=\"submit\">Reset all to file defaults</button>\n</form>\n</div>\n</div>\n</div>\n<style>\n.st-field { margin: 0 0 28px 0; }\n.st-field h3 { margin: 0 0 8px 0; }\n.st-field p { margin: 0 0 12px 0; }\n.st-forms { display: flex; flex-wrap: wrap; gap: 12px; }\n.st-forms form { margin: 0; }\n.st-note { font-size: 16px; }\n#st-status { font-size: 18px; }\n</style>\n<script>\n/* Settings panel. Stateless: no theme in app state, no act() calls.\n * Reads the shell theme through GET /theme/<id> (cookie session),\n * renders each field's effective value with its source, and submits\n * changes as plain GET forms. With JavaScript, submits go through\n * fetch with format=json and re-render in place; without it, the\n * form round-trips with a 303 back to this panel. Pure functions are\n * defined first so Node tests can load this script without a DOM and\n * call them directly; DOM wiring is guarded by typeof document. */\nfunction stAppIdFromBase(base) {\n  var parts = String(base).split('/');\n  for (var i = 0; i < parts.length; i++) {\n    if (parts[i] === 'apps' && i + 1 < parts.length) return parts[i + 1];\n  }\n  return '';\n}\nfunction stThemeBase(base) {\n  var id = stAppIdFromBase(base);\n  if (id === '') return '';\n  return String(base).replace('/apps/' + id, '/theme/' + id);\n}\nfunction stIsGrid(value) {\n  return typeof value === 'object' && value !== null && Array.isArray(value.grid);\n}\nfunction stIsSvg(value) {\n  return typeof value === 'string' && value.indexOf('<svg') === 0;\n}\nfunction stSourceLabel(field, override) {\n  if (override && override[field] !== undefined) return 'override';\n  return 'file default';\n}\nfunction stDisplayValue(field, effective) {\n  if (field === 'background') {\n    if (stIsGrid(effective.background)) return 'custom grid';\n    return effective.background;\n  }\n  if (field === 'icon') {\n    if (stIsSvg(effective.icon)) return 'custom mark';\n    if (effective.icon === '') return 'stock mark';\n    return effective.icon;\n  }\n  if (field === 'showHelp' || field === 'showAbout') {\n    return effective[field] === false ? 'hidden' : 'shown';\n  }\n  return effective[field];\n}\nfunction stFormQuery(form) {\n  var params = new URLSearchParams();\n  var els = form.elements || [];\n  for (var i = 0; i < els.length; i++) {\n    var el = els[i];\n    if (el.name) params.append(el.name, el.value);\n  }\n  params.set('format', 'json');\n  if (typeof window !== 'undefined' && window.location) params.set('from', window.location.pathname);\n  return params.toString();\n}\nif (typeof document !== 'undefined') {\n  var stRoot = document.querySelector('.st');\n  var stBase = '';\n  var stNode = stRoot;\n  while (stNode) {\n    if (stNode.getAttribute) {\n      var stFound = stNode.getAttribute('data-action-base');\n      if (stFound) { stBase = stFound; break; }\n    }\n    stNode = stNode.parentNode;\n  }\n  if (stBase === '' && typeof window !== 'undefined' && window.location) stBase = window.location.pathname;\n  var stTheme = stThemeBase(stBase);\n  var stStatus = document.getElementById('st-status');\n  var stPanel = document.getElementById('st-panel');\n  function stSetStatus(text) { if (stStatus) stStatus.textContent = text; }\n  function stRender(theme) {\n    var fields = ['background', 'name', 'title', 'icon', 'showHelp', 'showAbout'];\n    for (var i = 0; i < fields.length; i++) {\n      var field = fields[i];\n      var valueEl = document.getElementById('st-' + field + '-value');\n      if (valueEl) valueEl.textContent = stDisplayValue(field, theme.effective);\n      var sourceEl = document.getElementById('st-' + field + '-source');\n      if (sourceEl) sourceEl.textContent = stSourceLabel(field, theme.override);\n    }\n    var bgNote = document.getElementById('st-background-note');\n    if (bgNote) bgNote.style.display = stIsGrid(theme.effective.background) ? '' : 'none';\n    var iconNote = document.getElementById('st-icon-note');\n    if (iconNote) iconNote.style.display = stIsSvg(theme.effective.icon) ? '' : 'none';\n    var nameInput = document.getElementById('st-name-input');\n    if (nameInput) nameInput.value = theme.effective.name;\n    var titleInput = document.getElementById('st-title-input');\n    if (titleInput) titleInput.value = theme.override.title !== undefined ? theme.override.title : '';\n    var iconInput = document.getElementById('st-icon-input');\n    if (iconInput) iconInput.value = (theme.override.icon !== undefined && !stIsSvg(theme.override.icon)) ? theme.override.icon : '';\n    if (stPanel) stPanel.style.display = '';\n  }\n  function stLoad() {\n    if (stTheme === '') { stSetStatus('Could not find this app on the page.'); return; }\n    fetch(stTheme + '?format=json', { credentials: 'same-origin' }).then(function (resp) {\n      return resp.json();\n    }).then(function (theme) {\n      if (!theme || theme.ok !== true) { stSetStatus('Could not read the shell theme.'); return; }\n      stRender(theme);\n      stSetStatus('');\n    }).catch(function () {\n      stSetStatus('Could not read the shell theme.');\n    });\n  }\n  var stForms = document.querySelectorAll ? document.querySelectorAll('.st form') : [];\n  for (var f = 0; f < stForms.length; f++) {\n    (function (form) {\n      form.addEventListener('submit', function (ev) {\n        ev.preventDefault();\n        var action = form.getAttribute('action') || stTheme;\n        var url = action + (action.indexOf('?') === -1 ? '?' : '&') + stFormQuery(form);\n        fetch(url, { credentials: 'same-origin' }).then(function (resp) {\n          return resp.json();\n        }).then(function (result) {\n          if (!result || result.ok !== true) {\n            stSetStatus(result && result.error ? result.error : 'That change was not saved.');\n            return;\n          }\n          stSetStatus('Saved.');\n          stLoad();\n        }).catch(function () {\n          form.submit();\n        });\n      });\n    })(stForms[f]);\n  }\n  if (stTheme !== '') {\n    for (var g = 0; g < stForms.length; g++) { stForms[g].setAttribute('action', stTheme); }\n  }\n  stLoad();\n}\n</script>\n"
    }
  },
  "ui": {
    "title": "Settings",
    "openAs": "page"
  },
  "stateSchema": {
    "type": "object",
    "initial": {},
    "fields": {}
  },
  "actions": {}
}
