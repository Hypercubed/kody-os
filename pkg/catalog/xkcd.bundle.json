      "index.html": "<div class=\"feed\">\n<div class=\"feed-nav\">\n<button id=\"feed-prev\" type=\"button\" aria-label=\"Previous\" title=\"Previous\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"15 18 9 12 15 6\"></polyline></svg></button>\n<span id=\"feed-pos\"></span>\n<button id=\"feed-next\" type=\"button\" aria-label=\"Next\" title=\"Next\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"9 18 15 12 9 6\"></polyline></svg></button>\n</div>\n<div class=\"feed-actions\">\n<button id=\"feed-refresh\" type=\"button\">Refresh</button>\n<span id=\"feed-status\" class=\"feed-status\"></span>\n</div>\n<h2 id=\"feed-title\"></h2>\n<div id=\"feed-date\" class=\"feed-date\"></div>\n<div id=\"feed-body\"></div>\n</div>\n<style>\n\n.feed-nav { display: grid; grid-template-columns: auto 1fr auto; align-items: center; margin: 12px 0 12px 0; }\n.feed-nav button { display: flex; align-items: center; justify-content: center; }\n\n\n#feed-pos { font-size: 18px; text-align: center; white-space: pre-wrap; padding: 0 12px; }\n.feed-actions { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 12px; margin: 0 0 12px 0; }\n.feed-status { font-size: 14px; }\n#feed-title { font-size: 20px; margin: 16px 0 4px 0; }\n.feed-date { font-size: 14px; margin: 0 0 12px 0; }\n#feed-body { white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word; font-family: system-ui, sans-serif; font-size: 18px; line-height: 1.4; margin: 0; }\n#feed-body p { margin: 0 0 12px 0; white-space: pre-wrap; }\n#feed-body a { color: #000; text-decoration: underline; overflow-wrap: break-word; word-break: break-all; }\n#feed-body img { max-width: 100%; height: auto; display: block; margin: 12px auto; border: 1px solid #000; }\n#feed-body h1, #feed-body h2, #feed-body h3 { font-size: 18px; margin: 16px 0 8px 0; }\n#feed-body ul, #feed-body ol { margin: 0 0 12px 20px; padding: 0; }\n#feed-body blockquote { margin: 0 0 12px 0; padding-left: 12px; border-left: 2px solid #000; }\n#feed-body pre, #feed-body code { white-space: pre-wrap; word-wrap: break-word; font-family: ui-monospace, monospace; font-size: 16px; }\n.feed-alt { font-size: 16px; font-style: italic; margin: 8px 0 12px 0; white-space: pre-wrap; }\n.app-body p { white-space: pre-wrap; }\n</style>\n<script>\nvar xkcdScriptEl = null;\ntry { xkcdScriptEl = document.currentScript; } catch (err) { xkcdScriptEl = null; }\nvar xkcdSectionEl = null;\n(function () {\n  var el = xkcdScriptEl;\n  while (el) {\n    if (el.getAttribute && el.getAttribute('data-app-id')) { xkcdSectionEl = el; break; }\n    el = el.parentNode;\n  }\n  if (!xkcdSectionEl) {\n    var sections = document.querySelectorAll('section[data-app-id]');\n    if (sections.length > 0) { xkcdSectionEl = sections[0]; }\n  }\n})();\n(function () {\n  var FEED_URL = \"https://xkcd.com/rss.xml\";\n  var CACHE_KEY = \"xkcd-feed-v1\";\n  function fieldText(name) {\n    var p = document.querySelector('p[data-field=\"' + name + '\"]');\n    if (!p) { return \"\"; }\n    var span = p.querySelector(\"span\");\n    if (!span) { return \"\"; }\n    var text = span.textContent;\n    if (text) { return text; }\n    var attr = span.getAttribute(\"data-value\");\n    return attr ? attr : \"\";\n  }\n  function hideField(name) {\n    var p = document.querySelector('p[data-field=\"' + name + '\"]');\n    if (p) { p.style.display = \"none\"; }\n  }\n  function escapeHtml(text) {\n    return text.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\");\n  }\n  function unescapeEntities(text) {\n    return text.replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\").replace(/&quot;/g, '\"').replace(/&apos;/g, \"'\").replace(/&#39;/g, \"'\").replace(/&#x27;/g, \"'\").replace(/&amp;/g, \"&\");\n  }\n  function childText(parent, tag) {\n    var i, node;\n    for (i = 0; i < parent.childNodes.length; i++) {\n      node = parent.childNodes[i];\n      if (node.nodeType === 1 && node.nodeName === tag) {\n        return node.textContent || \"\";\n      }\n    }\n    return \"\";\n  }\n  function tagValue(block, tag) {\n    var re = new RegExp(\"<\" + tag + \"[^>]*>([\\\\s\\\\S]*?)</\" + tag + \">\");\n    var m = re.exec(block);\n    if (!m) { return \"\"; }\n    var v = m[1];\n    if (v.indexOf(\"<![CDATA[\") === 0) { v = v.slice(9); }\n    if (v.slice(-3) === \"]]>\") { v = v.slice(0, -3); }\n    return unescapeEntities(v);\n  }\n  function parseFeedXmlRegex(text) {\n    var items = [];\n    var re = /<item>([\\s\\S]*?)<\\/item>/g;\n    var m;\n    while ((m = re.exec(text)) !== null) {\n      var block = m[1];\n      items.push({\n        title: tagValue(block, \"title\"),\n        link: tagValue(block, \"link\"),\n        guid: tagValue(block, \"guid\"),\n        pubDate: tagValue(block, \"pubDate\"),\n        description: tagValue(block, \"description\") || tagValue(block, \"content:encoded\")\n      });\n    }\n    return items.length ? items : null;\n  }\n  function parseFeedXml(xmlText) {\n    var text = (xmlText || \"\").replace(/^\\s+/, \"\").replace(/\\s+$/, \"\");\n    if (!text) { return null; }\n    if (text.indexOf(\"<rss\") === -1 && text.indexOf(\"&lt;rss\") !== -1) {\n      text = unescapeEntities(text);\n    }\n    if (typeof DOMParser === \"undefined\") { return parseFeedXmlRegex(text); }\n    var doc;\n    try {\n      doc = new DOMParser().parseFromString(text, \"text/xml\");\n    } catch (e) {\n      return parseFeedXmlRegex(text);\n    }\n    if (!doc) { return parseFeedXmlRegex(text); }\n    var errs = doc.getElementsByTagName(\"parsererror\");\n    if (errs && errs.length > 0) { re