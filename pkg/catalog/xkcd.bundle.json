1, TBODY: 1, TR: 1, TH: 1, TD: 1, DIV: 1, SPAN: 1};\n    var dropped = {SCRIPT: 1, STYLE: 1, IFRAME: 1, OBJECT: 1, EMBED: 1, FORM: 1, INPUT: 1, BUTTON: 1, SELECT: 1, TEXTAREA: 1, LINK: 1, META: 1, TITLE: 1, SVG: 1, MATH: 1, VIDEO: 1, AUDIO: 1, SOURCE: 1, TRACK: 1, NOSCRIPT: 1};\n    var imgCount = 0;\n    var out = document.createElement(\"div\");\n    function cleanNode(node, parent) {\n      var i;\n      if (node.nodeType === 3) {\n        parent.appendChild(document.createTextNode(node.nodeValue));\n        return;\n      }\n      if (node.nodeType !== 1) { return; }\n      var tag = node.tagName;\n      if (dropped[tag]) { return; }\n      if (tag === \"IMG\") {\n        if (imgCount >= 5) { return; }\n        var src = node.getAttribute(\"src\") || \"\";\n        var resolved = resolveUrl(src, baseUrl);\n        if (!isSafeUrl(resolved)) { return; }\n        imgCount = imgCount + 1;\n        var img = document.createElement(\"img\");\n        img.setAttribute(\"src\", resolved);\n        var alt = node.getAttribute(\"alt\") || node.getAttribute(\"title\") || \"\";\n        if (alt) { img.setAttribute(\"alt\", alt); }\n        parent.appendChild(img);\n        return;\n      }\n      if (tag === \"A\") {\n        var href = node.getAttribute(\"href\") || \"\";\n        var resolvedHref = resolveUrl(href, baseUrl);\n        if (!isSafeUrl(resolvedHref)) {\n          for (i = 0; i < node.childNodes.length; i++) { cleanNode(node.childNodes[i], parent); }\n          return;\n        }\n        var a = document.createElement(\"a\");\n        a.setAttribute(\"href\", resolvedHref);\n        for (i = 0; i < node.childNodes.length; i++) { cleanNode(node.childNodes[i], a); }\n        parent.appendChild(a);\n        return;\n      }\n      if (allowed[tag]) {\n        var el = document.createElement(tag.toLowerCase());\n        for (i = 0; i < node.childNodes.length; i++) { cleanNode(node.childNodes[i], el); }\n        parent.appendChild(el);\n        return;\n      }\n      for (i = 0; i < node.childNodes.length; i++) { cleanNode(node.childNodes[i], parent); }\n    }\n    for (var k = 0; k < doc.body.childNodes.length; k++) {\n      cleanNode(doc.body.childNodes[k], out);\n    }\n    return out;\n  }\n  function looksLikeHtml(s) {\n    return s.indexOf(\"<img\") !== -1 || s.indexOf(\"<p\") !== -1 || s.indexOf(\"<a \") !== -1 || s.indexOf(\"<br\") !== -1 || s.indexOf(\"<ul\") !== -1 || s.indexOf(\"<ol\") !== -1;\n  }\n  function linkify(text) {\n    var escaped = escapeHtml(text);\n    return escaped.replace(/(https?:\\/\\/[^\\s<]+)/g, function (match, url) {\n      var trailing = \"\";\n      while (url.length > 0 && '.,;:!?)]}\"'.indexOf(url.charAt(url.length - 1)) !== -1) {\n        trailing = url.charAt(url.length - 1) + trailing;\n        url = url.slice(0, -1);\n      }\n      return '<a href=\"' + url + '\">' + url + '</a>' + trailing;\n    });\n  }\n  function init() {\n    var body = document.getElementById(\"feed-body\");\n    var pos = document.getElementById(\"feed-pos\");\n    var titleEl = document.getElementById(\"feed-title\");\n    var dateEl = document.getElementById(\"feed-date\");\n    var statusEl = document.getElementById(\"feed-status\");\n    var prevBtn = document.getElementById(\"feed-prev\");\n    var nextBtn = document.getElementById(\"feed-next\");\n    var refreshBtn = document.getElementById(\"feed-refresh\");\n    if (!body || !pos || !prevBtn || !nextBtn || !titleEl || !dateEl || !statusEl || !refreshBtn) { return; }\n    var items = [];\n    /* Bridge (Phase 2): initial feed comes from the JSON seed via the\n     * bridge store, falling back to the span readout when the bridge is\n     * absent. The bundle never dispatches set_feed itself -- that action\n     * is for external writers -- so this port changes no server writes;\n     * the subscription only re-renders when an external writer changes\n     * the stored feed while the page is open. Navigation index stays\n     * local, like before. */\n    var xkcdStore = null;\n    if (typeof window !== 'undefined' && window.KodyBridge && xkcdSectionEl) {\n      xkcdStore = window.KodyBridge.create(xkcdSectionEl, { fieldTypes: { feed: 'string' } });\n      xkcdStore.subscribe(function (snap) {\n        var feed = snap.desired.feed || '';\n        var parsed = parseFeedXml(feed);\n        if (parsed && parsed.length > 0) { setItems(parsed, 'Stored feed'); render(); }\n      });\n      xkcdStore.startSpanObserver();\n    }\n    var index = 0;\n    var sourceLabel = \"\";\n    function setItems(feedItems, label) {\n      var reversed = [];\n      var r;\n      for (r = feedItems.length - 1; r >= 0; r--) { reversed.push(feedItems[r]); }\n      items = reversed;\n      index = items.length - 1;\n      sourceLabel = label;\n    }\n    function saveCache(xml) {\n      try {\n        if (typeof localStorage !== \"undefined\") {\n          localStorage.setItem(CACHE_KEY, JSON.stringify({xml: xml, fetchedAt: new Date().getTime()}));\n        }\n      } catch (e) { /* storage unavailable; stored feed still works */ }\n    }\n    function loadCache() {\n      try {\n        if (typeof localStorage === \"undefined\") { return null; }\n        var raw = localStorage.getItem(CACHE_KEY);\n        if (!raw) { return null; }\n        var parsed = JSON.parse(raw);\n        if (!parsed || !parsed.xml) { return null; }\n        return parsed;\n      } catch (e) {\n        return null;\n      }\n    }\n    function wrapImagesInLinks(container, link) {\n      var safe = safeLink(link);\n      if (!safe) { return; }\n      var imgs = container.getElementsByTagName(\"img\");\n      var list = [];\n      var i;\n      for (i = 0; i < imgs.length; i++) { list.push(imgs[i]); }\n      for (i = 0; i < list.length; i++) {\n        var img = list[i];\n        if (img.parentNode && img.parentNode.tagName === \"A\") { continue; }\n        var a = document.createElement(\"a\");\n        a.setAttribute(\"href\", safe);\n        img.parentNode.insertBefore(a, img);\n        a.appendChild(img);\n      }\n    }\n    function addAltCaptions(container) {\n      var imgs = container.getElementsByTagName(\"img\");\n      var list = [];\n      var i;\n      for (i = 0; i < imgs.length; i++) { list.push(imgs[i]); }\n      for (i = 0; i < list.length; i++) {\n        var img = list[i];\n        var alt = img.getAttribute(\"alt\") || \"\";\n        if (!alt) { continue; }\n        var cap = document.createElement(\"p\");\n        cap.className = \"feed-alt\";\n        cap.textContent = alt;\n        var target = img;\n        if (img.parentNode && img.parentNode.tagName === \"A\") { target = img.parentNode; }\n        if (target.parentNode) { target.parentNode.insertBefore(cap, target.nextSibling); }\n      }\n    }\n    function render() {\n      if (items.length === 0) {\n        body.textContent = \"No comics yet. Tap Refresh to fetch xkcd.\";\n        pos.textContent = \"\";\n        titleEl.textContent = \"\";\n        dateEl.textContent = \"\";\n        prevBtn.disabled = true;\n        nextBtn.disabled = true;\n        return;\n      }\n      var item = items[index];\n      titleEl.textContent = item.title || \"xkcd\";\n      dateEl.textContent = formatPubDate(item.pubDate);\n      var desc = item.description || \"\";\n      while (body.firstChild) { body.removeChild(body.firstChild); }\n      var safeItemLink = safeLink(item.link);\n      var usedHtml = false;\n      if (looksLikeHtml(desc)) {\n        var clean = sanitizeHtml(desc, safeItemLink || FEED_URL);\n        if (clean && clean.textContent.replace(/^\\s+/, \"\").replace(/\\s+$/, \"\")) {\n          wrapImagesInLinks(clean, safeItemLink);\n          body.appendChild(clean);\n          addAltCaptions(body);\n          usedHtml = true;\n        } else if (clean) {\n          wrapImagesInLinks(clean, safeItemLink);\n          body.appendChild(clean);\n          addAltCaptions(body);\n          usedHtml = true;\n        }\n      }\n      if (!usedHtml) {\n        body.innerHTML = linkify(desc);\n      }\n      if (safeItemLink) {\n        var linkP = document.createElement(\"p\");\n        var linkA = document.createElement(\"a\");\n        linkA.setAttribute(\"href\", safeItemLink);\n        linkA.textContent = \"View on xkcd.com\";\n        linkP.appendChild(linkA);\n        body.appendChild(linkP);\n      }\n      pos.textContent = formatPubDate(item.pubDate) + \"\\n\" + (index + 1) + \" of \" + items.length;\n      statusEl.textContent = sourceLabel;\n      prevBtn.disabled = index <= 0;\n      nextBtn.disabled = index >= items.length - 1;\n    }\n    function proxyFeedUrl() {\n      var base = \"\";\n      var el = document.getElementById(\"feed-refresh\");\n      while (el) {\n        if (el.getAttribute) {\n          var ab = el.getAttribute(\"data-action-base\");\n          if (ab) { base = ab; break; }\n        }\n        el = el.parentNode;\n      }\n      if (!base && typeof window.location !== \"undefined\") {\n        base = window.location.pathname || \"\";\n      }\n      var suffix = \"/apps/xkcd\";\n      if (base.length > suffix.length && base.slice(base.length - suffix.length) === suffix) {\n        base = base.slice(0, base.length - suffix.length);\n      } else if (base === suffix) {\n        base = \"\";\n      } else {\n        var appsAt = base.indexOf(\"/apps/\");\n        if (appsAt !== -1) { base = base.slice(0, appsAt); }\n        else { base = \"\"; }\n      }\n      var url = base + \"/feed/xkcd/xkcd\";\n      if (typeof window.location !== \"undefined\" && window.location.search) {\n        var m = /(?:^|[?&])k=([^&]+)/.exec(window.location.search);\n        if (m) { url = url + \"?k=\" + encodeURIComponent(m[1]); }\n      }\n      return url;\n    }\n    function fetchText(url, withCreds, onOk, onErr) {\n      if (typeof fetch === \"function\") {\n        var opts = withCreds ? { credentials: \"same-origin\" } : {};\n        fetch(url, opts).then(function (res) {\n          if (!res.ok)