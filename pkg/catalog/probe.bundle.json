    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n<title>Scribe Probe</title>\n<style>\nbody { font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; margin: 1em; color: #000; background: #fff; }\ntable { border-collapse: collapse; width: 100%; }\ntd, th { border: 2px solid #000; padding: 0.5em; text-align: left; font-size: 18px; }\nbutton { font-size: 24px; padding: 0.75em 1.5em; margin: 1em 0; border: 3px solid #000; background: #fff; }\n.fail { background: #000; color: #fff; }\n</style>\n</head>\n<body>\n<h1>Scribe Probe</h1>\n<noscript><p><strong>JavaScript is OFF in this browser.</strong></p></noscript>\n<script>try{var __pp=window.location.pathname;var __pi=__pp.indexOf(\"/apps/\");var __pb=__pi!==-1?__pp.slice(0,__pi)+\"/apps/probe\":\"/apps/probe\";var __pu=__pb+\"?action=append_report&tag=alive&d=\"+encodeURIComponent(\"alive=js-on\")+\"&format=json\";var __pm=new RegExp(\"[?&]k=([^&]*)\").exec(window.location.search||\"\");if(__pm){__pu+=\"&k=\"+__pm[1];}var __alive=new Image();__alive.src=__pu;}catch(__e){}</script>\n<p>Step 1: wait 5 seconds (timer + network tests run automatically).</p>\n<p>Step 2: tap TAP ME once (event tests).</p>\n<p>Step 3: tap SEND RESULTS (fires every result home), or SEND (navigate) as a fallback.</p>\n<button id=\"tapbtn\" type=\"button\">TAP ME</button>\n<button id=\"sendbtn\" type=\"button\">SEND RESULTS</button>\n<button id=\"navbtn\" type=\"button\">SEND (navigate)</button>\n<p id=\"sendstatus\"></p>\n<table id=\"results\"><tr><th>Test</th><th>Result</th></tr></table>\n<script>\nvar results = {};\nfunction row(name, value) {\n  results[name] = String(value);\n  try {\n    var t = document.getElementById(\"results\");\n    var tr = document.createElement(\"tr\");\n    var a = document.createElement(\"td\"); a.textContent = name;\n    var b = document.createElement(\"td\"); b.textContent = String(value);\n    if (value !== true && value !== \"true\" && value !== \"yes\") b.className = \"fail\";\n    tr.appendChild(a); tr.appendChild(b); t.appendChild(tr);\n  } catch (e) {}\n  beaconRow(name, value);\n}\nfunction actBase() {\n  try {\n    var p = window.location.pathname;\n    var i = p.indexOf(\"/apps/\");\n    if (i !== -1) {\n      var tail = p.slice(i + 6);\n      var slash = tail.indexOf(\"/\");\n      var id = slash === -1 ? tail : tail.slice(0, slash);\n      if (id) { return p.slice(0, i) + \"/apps/\" + id; }\n    }\n  } catch (e) {}\n  return \"/apps/probe\";\n}\nfunction codeSuffix() {\n  try {\n    var m = new RegExp(\"[?&]k=([^&]*)\").exec(window.location.search || \"\");\n    if (m) { return \"&k=\" + m[1]; }\n  } catch (e2) {}\n  return \"\";\n}\nfunction pingUrl() {\n  var base = actBase();\n  try {\n    var m = new RegExp(\"[?&]k=([^&]*)\").exec(window.location.search || \"\");\n    if (m) { return base + \"?k=\" + m[1]; }\n  } catch (e3) {}\n  return base;\n}\nfunction actUrl(tag, d) {\n  return actBase() + \"?action=append_report&tag=\" + encodeURIComponent(tag) + \"&d=\" + encodeURIComponent(String(d)).slice(0, 160) + \"&format=json\" + codeSuffix();\n}\nfunction fireUrl(url) {\n  try {\n    if (typeof fetch === \"function\") {\n      fetch(url, { headers: { \"Accept\": \"application/json\" } }).then(function () {}, function () {});\n    }\n  } catch (e4) {}\n  try {\n    var im = new Image(1, 1);\n    im.setAttribute(\"width\", \"1\");\n    im.setAttribute(\"height\", \"1\");\n    im.setAttribute(\"aria-hidden\", \"true\");\n    im.src = url;\n    if (document.body && document.body.appendChild) document.body.appendChild(im);\n  } catch (e5) {}\n  try {\n    if (typeof XMLHttpRequest !== \"undefined\") {\n      var xh = new XMLHttpRequest();\n      xh.open(\"GET\", url, true);\n      try { xh.send(); } catch (e6) {}\n    }\n  } catch (e7) {}\n}\nfunction beacon(tag) {\n  fireUrl(actUrl(tag, tag + \"=\"));\n}\nfunction beaconRow(name, value) {\n  fireUrl(actUrl(\"row:\" + name, \"row:\" + name + \"=\" + String(value)));\n}\nfunction sendAll() {\n  var keys = [\"json\",\"fetch\",\"xhr\",\"fetchWorks\",\"xhrWorks\",\"timer5000\",\"event-click\",\"cssGrid\",\"localStorage\",\"cookie\",\"customElements\",\"customElementDefine\",\"customElementUpgrade\",\"websocket\",\"websocketConnect\",\"blob\",\"objectURL\",\"fileReader\",\"serviceWorker\",\"syncManager\",\"periodicSync\",\"notification\",\"rAF\",\"rAFFired\",\"mutationObserver\",\"intersectionObserver\",\"resizeObserver\",\"customEvent\",\"historyPush\",\"clipboard\",\"geolocation\",\"matchMediaMono\",\"hardwareConcurrency\",\"deviceMemory\",\"onLine\"];\n  var n = 0;\n  for (var i = 0; i < keys.length; i++) { if (results[keys[i]] !== undefined) { beaconRow(keys[i], results[keys[i]]); n++; } }\n  beacon(\"manual\");\n  setStatus(\"Sent \" + n + \" beacons.\");\n}\nfunction navSend() {\n  var keys = [\"json\",\"fetch\",\"xhr\",\"fetchWorks\",\"xhrWorks\",\"timer5000\",\"event-click\",\"cssGrid\",\"localStorage\",\"cookie\",\"customElements\",\"customElementDefine\",\"customElementUpgrade\",\"websocket\",\"websocketConnect\",\"blob\",\"objectURL\",\"fileReader\",\"serviceWorker\",\"syncManager\",\"periodicSync\",\"notification\",\"rAF\",\"rAFFired\",\"mutationObserver\",\"intersectionObserver\",\"resizeObserver\",\"customEvent\",\"historyPush\",\"clipboard\",\"geolocation\",\"matchMediaMono\",\"hardwareConcurrency\",\"deviceMemory\",\"onLine\",\"sessionStorage\",\"viewport\"];\n  var parts = [];\n  for (var j = 0; j < keys.length; j++) parts.push(keys[j] + \"=\" + (results[keys[j]] === undefined ? \"Q\" : results[keys[j]]));\n  setStatus(\"Navigating with summary - use Back to return.\");\n  window.location = actBase() + \"?action=append_report&tag=manualnav&d=\" + encodeURIComponent(\"manualnav=\" + parts.join(\"|\")).slice(0, 1500) + codeSuffix();\n}\ntry {\n  var sb = document.getElementById(\"sendbtn\");\n  if (sb) { if (sb.addEventListener) sb.addEventListener(\"click\", function () { sendAll(); }); else if (sb.attachEvent) sb.attachEvent(\"onclick\", function () { sendAll(); }); }\n  var nb = document.getElementById(\"navbtn\");\n  if (nb) { if (nb.addEventListener) nb.addEventListener(\"click\", function () { navSend(); }); else if (nb.attachEvent) nb.attachEvent(\"onclick\", function () { navSend(); }); }\n} catch (e) {}\ntry { row(\"ua\", navigator.userAgent); } catch (e) { row(\"ua\", \"ERROR\"); }\ntry { row(\"screen\", screen.width + \"x\" + screen.height + \" dpr=\" + (window.devicePixelRatio || \"?\") + \" depth=\" + screen.colorDepth); } catch (e) { row(\"screen\", \"ERROR\"); }\ntry { row(\"viewport\", window.innerWidth + \"x\" + window.innerHeight); } catch (e) { row(\"viewport\", \"ERROR\"); }\ntry { row(\"json\", typeof JSON !== \"undefined\" && typeof JSON.parse === \"function\"); } catch (e) { row(\"json\", \"ERROR\"); }\ntry { row(\"promise\", typeof Promise !== \"undefined\"); } catch (e) { row(\"promise\", \"ERROR\"); }\ntry { row(\"symbol\", typeof Symbol !== \"undefined\"); } catch (e) { row(\"symbol\", \"ERROR\"); }\ntry { row(\"mapset\", typeof Map !== \"undefined\" && typeof Set !== \"undefined\"); } catch (e) { row(\"mapset\", \"ERROR\"); }\ntry { row(\"objectAssign\", typeof Object.assign === \"function\"); } catch (e) { row(\"objectAssign\", \"ERROR\"); }\ntry { row(\"arrayIncludes\", typeof Array.prototype.includes === \"function\"); } catch (e) { row(\"arrayIncludes\", \"ERROR\"); }\ntry { row(\"stringStartsWith\", typeof String.prototype.startsWith === \"function\"); } catch (e) { row(\"stringStartsWith\", \"ERROR\"); }\ntry { row(\"fetch\", typeof fetch === \"function\"); } catch (e) { row(\"fetch\", \"ERROR\"); }\ntry { row(\"xhr\", typeof XMLHttpRequest !== \"undefined\"); } catch (e) { row(\"xhr\", \"ERROR\"); }\ntry { row(\"formData\", typeof FormData !== \"undefined\"); } catch (e) { row(\"formData\", \"ERROR\"); }\ntry { row(\"imageBeacon\", typeof Image !== \"undefined\"); } catch (e) { row(\"imageBeacon\", \"ERROR\"); }\ntry { row(\"qsa\", typeof document.querySelector === \"function\"); } catch (e) { row(\"qsa\", \"ERROR\"); }\ntry { row(\"addevent\", typeof document.addEventListener === \"function\"); } catch (e) { row(\"addevent\", \"ERROR\"); }\ntry { row(\"classList\", !!(document.body && document.body.classList)); } catch (e) { row(\"classList\", \"ERROR\"); }\ntry { row(\"getComputedStyle\", typeof getComputedStyle === \"function\"); } catch (e) { row(\"getComputedStyle\", \"ERROR\"); }\ntry {\n  var CE = window.customElements;\n  var ceOk = (typeof CE !== \"undefined\") && (typeof CE.define === \"function\") && (typeof CE.get === \"function\") && (typeof CE.whenDefined === \"function\");\n  row(\"customElements\", ceOk);\n  if (ceOk) {\n    try {\n      var hermes = CE.get(\"probe-el-v7\");\n      row(\"customElementRegistry\", hermes === undefined);\n    } catch (e2) { row(\"customElementRegistry\", \"ERROR\"); }\n    try {\n      var PE = function () {};\n      PE.prototype = Object.create(HTMLElement.prototype);\n      CE.define(\"probe-el-v7\", PE);\n      row(\"customElementDefine\", CE.get(\"probe-el-v7\") ? \"defined\" : \"missing\");\n    } catch (e3) { row(\"customElementDefine\", \"threw\"); }\n    try {\n      var inst = document.createElement(\"probe-el-v7\");\n      row(\"customElementUpgrade\", (inst && inst.localName === \"probe-el-v7\") ? \"upgraded\" : \"odd\");\n    } catch (e4) { row(\"customElementUpgrade\", \"super-required\"); }\n  } else { row(\"customElementRegistry\", \"n/a\"); row(\"customElementDefine\", \"n/a\"); row(\"customElementUpgrade\", \"n/a\"); }\n} catch (e5) { row(\"customElements\", \"ERROR\"); }\ntry {\n  var wsOk = (typeof WebSocket !== \"undefined\");\n  row(\"websocket\", wsOk);\n  if (wsOk) {\n    try {\n      var ws = new WebSocket(\"wss://127.0.0.1:9/\");\n      ws.onopen = function () { results[\"websocketConnect\"] = \"opened\"; row(\"websocketConnect\", \"opened\"); };\n      ws.onerror = function () { results[\"websocketConnect\"] = \"error\"; row(\"websocketConnect\", \"error\"); };\n      ws.onclose = function () { if (results[\"websocketConnect\"] === undefined) { results[\"websocketConnect\"] = \"closed\"; row(\"websocketConnect\", \"closed\"); } };\n    } catch (e6) { row(\"websocketConnect\", \"threw\"); }\n  } else { row(\"websocketConnect\", \"n/a\"); }\n} catch (e7) { row(\"websocket\", \"ERROR\"); row(\"websocketConnect\", \"ERROR\"); }\ntry {\n  var blb = new Blob([\"x\"], {type: \"text/plain\"});\n  row(\"blob\", (blb && blb.size === 1) ? \"yes\" : \"odd\");\n  try {\n    var ourl = (typeof URL !== \"undefined\" && URL.createObjectURL) ? URL.createObjectURL(blb) : \"\";\n    row(\"objectURL\", (ourl && ourl.indexOf(\"blob:\") === 0) ? \"yes\" : \"no\");\n    try { if (ourl && URL.revokeObjectURL) URL.revokeObjectURL(ourl); } catch (e8) {}\n  } catch (e9) { row(\"objectURL\", \"ERROR\"); }\n  try {\n    if (typeof FileReader !== \"undefined\") {\n      var fr = new FileReader();\n      fr.onload = function () { results[\"fileReader\"] = (fr.result === \"x\") ? \"yes\" : \"mismatch\"; row(\"fileReader\", results[\"fileReader\"]); };\n      fr.onerror = function () { results[\"fileReader\"] = \"ERROR\"; row(\"fileReader\", \"ERROR\"); };\n      fr.readAsText(blb);\n    } else { row(\"fileReader\", \"n/a\"); }\n  } catch (e10) { row(\"fileReader\", \"ERROR\"); }\n} catch (e11) { row(\"blob\", \"threw\"); row(\"objectURL\", \"n/a\"); row(\"fileReader\", \"n/a\"); }\ntry {\n  row(\"serviceWorker\", (typeof navigator !== \"undefined\" && \"serviceWorker\" in navigator) ? \"present\" : \"absent\");\n  row(\"syncManager\", (typeof window !== \"undefined\" && \"SyncManager\" in window) ? \"present\" : \"absent\");\n  row(\"periodicSync\", (typeof window !== \"undefined\" && \"PeriodicSyncManager\" in window) ? \"present\" : \"absent\");\n  row(\"notification\", (typeof window !== \"undefined\" && \"Notification\" in window) ? (\"present-\" + Notification.permission) : \"absent\");\n} catch (e12) { row(\"serviceWorker\", \"ERROR\"); }\ntry {\n  var rafOk = (typeof requestAnimationFrame === \"function\");\n  row(\"rAF\", rafOk);\n  if (rafOk) { requestAnimationFrame(function () { results[\"rAFFired\"] = \"fired\"; row(\"rAFFired\", \"fired\"); }); }\n  row(\"mutationObserver\", (typeof MutationObserver !== \"undefined\"));\n  row(\"intersectionObserver\", (typeof IntersectionObserver !== \"undefined\"));\n  row(\"resizeObserver\", (typeof ResizeObserver !== \"undefined\"));\n  row(\"customEvent\", (function () { try { var ce = new CustomEvent(\"probe-ce\"); return ce.type === \"probe-ce\"; } catch (e13) { return false; } })());\n  row(\"historyPush\", (typeof history !== \"undefined\" && typeof history.pushState === \"function\"));\n  row(\"clipboard\", (typeof navigator !== \"undefined\" && !!navigator.clipboard));\n  row(\"geolocation\", (typeof navigator !== \"undefined\" && !!navigator.geolocation));\n  row(\"matchMediaMono\", (typeof matchMedia === \"function\") ? (matchMedia(\"(monochrome)\").matches ? \"yes\" : \"no\") : \"n/a\");\n  row(\"hardwareConcurrency\", (typeof navigator !== \"undefined\" && navigator.hardwareConcurrency) ? String(navigator.hardwareConcurrency) : \"?\");\n  row(\"deviceMemory\", (typeof navigator !== \"undefined\" && navigator.deviceMemory) ? String(navigator.deviceMemory) : \"?\");\n  row(\"onLine\", (typeof navigator !== \"undefined\" && typeof navigator.onLine !== \"undefined\") ? String(navigator.onLine) : \"?\");\n} catch (e14) { row(\"rAF\", \"ERROR\"); }\ntry {\n  var s = document.body.style;\n  row(\"cssGrid\", \"gridTemplateColumns\" in s);\n  row(\"cssFlex\", \"flexBasis\" in s);\n  s.setProperty(\"--probe-test\", \"5px\");\n  row(\"cssVars\", s.getPropertyValue(\"--probe-test\") === \"5px\");\n} catch (e) { row(\"css\", \"ERROR\"); }\ntry {\n  var ls = \"no\", ss = \"no\", ck = \"no\";\n  try { localStorage.setItem(\"p\", \"1\"); ls = localStorage.getItem(\"p\") === \"1\" ? \"yes\" : \"broken\"; localStorage.removeItem(\"p\"); } catch (e) { ls = \"ERROR\"; }\n  try { sessionStorage.setItem(\"p\", \"1\"); ss = sessionStorage.getItem(\"p\") === \"1\" ? \"yes\" : \"broken\"; sessionStorage.removeItem(\"p\"); } catch (e) { ss = \"ERROR\"; }\n  try { document.cookie = \"probe=1\"; ck = document.cookie.indexOf(\"probe=1\") !== -1 ? \"yes\" : \"no\"; } catch (e) { ck = \"ERROR\"; }\n  row(\"localStorage\", ls); row(\"sessionStorage\", ss); row(\"cookie\", ck);\n} catch (e) { row(\"storage\", \"ERROR\"); }\nbeacon(\"load\");\ntry {\n  if (typeof XMLHttpRequest !== \"undefined\") {\n    var x = new XMLHttpRequest();\n    x.open(\"GET\", pingUrl(), true);\n    x.onload = function () { results[\"xhrWorks\"] = (x.status === 200) ? \"yes\" : (\"status-\" + x.status); };\n    x.onerror = function () { results[\"xhrWorks\"] = \"ERROR\"; };\n    try { x.send(); } catch (e) { results[\"xhrWorks\"] = \"SEND-ERROR\"; }\n  } else { results[\"xhrWorks\"] = \"n/a\"; }\n} catch (e) { results[\"xhrWorks\"] = \"ERROR\"; }\ntry {\n  if (typeof fetch === \"function\") {\n    fetch(pingUrl()).then(function (r) { results[\"fetchWorks\"] = (r.status === 200) ? \"yes\" : (\"status-\" + r.status); }, function () { results[\"fetchWorks\"] = \"ERROR\"; });\n  } else { results[\"fetchWorks\"] = \"n/a\"; }\n} catch (e) { results[\"fetchWorks\"] = \"ERROR\"; }\ntry {\n  setTimeout(function () {\n    row(\"timer5000\", \"fired\");\n    if (results[\"websocketConnect\"] === undefined) { results[\"websocketConnect\"] = \"hung\"; row(\"websocketConnect\", \"hung\"); }\n    if (results[\"rAFFired\"] === undefined && results[\"rAF\"] === \"true\") { results[\"rAFFired\"] = \"stalled\"; row(\"rAFFired\", \"stalled\"); }\n    if (results[\"fileReader\"] === undefined) { results[\"fileReader\"] = \"hung\"; row(\"fileReader\", \"hung\"); }\n    beacon(\"timed\");\n  }, 5000);\n  row(\"timerScheduled\", \"yes\");\n} catch (e) { row(\"timer