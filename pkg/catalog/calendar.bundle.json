{
  "id": "calendar",
  "name": "Calendar",
  "label": "Calendar",
  "schemaVersion": 5,
  "catalogVersion": 2,
  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\" /><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\" /><line x1=\"8\" y1=\"3\" x2=\"8\" y2=\"7\" /><line x1=\"16\" y1=\"3\" x2=\"16\" y2=\"7\" /></svg>",
  "category": "utilities",
  "description": "A month calendar that always opens on the current month, with today highlighted.",
  "bundle": {
    "entry": "index.html",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<style>\n.cal-wrap { font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; color: #111; background: #fff; padding: 16px; }\n.cal-bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin: 0 0 16px 0; }\n.cal-title { font-size: 24px; line-height: 1.2; margin: 0; text-align: center; }\n.cal-prev, .cal-next { min-height: 48px; font-size: 18px; background: #fff; color: #111; border: 2px solid #111; padding: 8px 16px; }\n.cal-prev { justify-self: start; }\n.cal-next { justify-self: end; }\n.cal-weekdays, .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); grid-gap: 4px; }\n.cal-weekdays { margin: 0 0 8px 0; font-weight: bold; text-align: center; }\n.cal-cell { min-height: 48px; display: flex; align-items: center; justify-content: center; font-size: 18px; }\n.cal-today { background: #111; color: #fff; font-weight: bold; }\n</style>\n</head>\n<body>\n<div class=\"cal-wrap\">\n<div class=\"cal-bar\"><button class=\"cal-prev\" type=\"button\">Prev</button><h2 class=\"cal-title\"></h2><button class=\"cal-next\" type=\"button\">Next</button></div>\n<div class=\"cal-weekdays\"><span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span></div>\n<div class=\"cal-grid\"></div>\n</div>\n<script>\nvar CAL_MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\nfunction calDaysInMonth(year, month) { return new Date(year, month + 1, 0).getDate(); }\nfunction calRender(root, year, month) {\n  var title = root.querySelector('.cal-title');\n  var grid = root.querySelector('.cal-grid');\n  if (!title || !grid) { return; }\n  title.textContent = CAL_MONTHS[month] + ' ' + String(year);\n  var now = new Date();\n  var todayYear = now.getFullYear();\n  var todayMonth = now.getMonth();\n  var todayDay = now.getDate();\n  var firstWeekday = new Date(year, month, 1).getDay();\n  var days = calDaysInMonth(year, month);\n  var html = '';\n  var i;\n  for (i = 0; i < firstWeekday; i++) { html += '<span class=\"cal-cell cal-blank\"></span>'; }\n  for (i = 1; i <= days; i++) {\n    var cls = 'cal-cell';\n    if (year === todayYear && month === todayMonth && i === todayDay) { cls += ' cal-today'; }\n    html += '<span class=\"' + cls + '\">' + String(i) + '</span>';\n  }\n  grid.innerHTML = html;\n}\nfunction calInit(root) {\n  var now = new Date();\n  var viewYear = now.getFullYear();\n  var viewMonth = now.getMonth();\n  var prev = root.querySelector('.cal-prev');\n  var next = root.querySelector('.cal-next');\n  function render() { calRender(root, viewYear, viewMonth); }\n  if (prev) {\n    prev.addEventListener('click', function () {\n      viewMonth -= 1;\n      if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }\n      render();\n    });\n  }\n  if (next) {\n    next.addEventListener('click', function () {\n      viewMonth += 1;\n      if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }\n      render();\n    });\n  }\n  render();\n}\nfunction calInitAll() {\n  var roots = document.querySelectorAll('.cal-wrap');\n  for (var i = 0; i < roots.length; i++) { calInit(roots[i]); }\n}\ncalInitAll();\n</script>\n</body>\n</html>\n"
    }
  },
