{
  "id": "daily-feed",
  "name": "Daily Feed",
  "label": "Daily Feed",
  "schemaVersion": 5,
  "catalogVersion": 5,
  "installMode": "recipe-or-json",
  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"1.5\" /><line x1=\"6.5\" y1=\"9\" x2=\"17.5\" y2=\"9\" /><line x1=\"6.5\" y1=\"12\" x2=\"17.5\" y2=\"12\" /><line x1=\"6.5\" y1=\"15\" x2=\"12\" y2=\"15\" /><circle cx=\"16.5\" cy=\"15\" r=\"1.2\" fill=\"currentColor\" stroke=\"none\" /></svg>",
  "category": "reading",
  "description": "A daily feed, updated by your agent, showing one entry at a time.",
  "bundle": {
    "entry": "index.html",
    "files": {
      "index.html": "<div class=\"df\">\n<div id=\"df-prompt\">\n<p>No daily feed data has been pushed to this app yet. (catalog test v4)</p>\n<h3>Set up the push</h3>\n<p>Copy this prompt into a Kody-connected agent:</p>\n<p class=\"gate-hint\"><code>Please set up a daily feed push for my kody-os app \"daily-feed\". Using Kody execute against kody:@hypercubed/kody-os, read its current state, prepend one new RSS item (newest first, at most 14 items total), and set the full feed with the act action \"set_feed\". Do not overwrite the feed if the current feed cannot be read or parsed. The feed is RSS XML with one item per entry, each with title, link, pubDate, and a plain-text description.<br><br>– App id: daily-feed<br>– Action: set_feed<br>– Format: RSS XML, newest first, at most 14 entries</code></p>\n<p>The app will show the latest entry once a push lands, with Previous and Next to step through entries.</p>\n</div>\n<div id=\"df-viewer\" style=\"display:none\">\n<div class=\"feed-nav\">\n<button id=\"df-prev\" type=\"button\" aria-label=\"Previous\" title=\"Previous\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"15 18 9 12 15 6\"></polyline></svg></button>\n<span id=\"df-pos\"></span>\n<button id=\"df-next\" type=\"button\" aria-label=\"Next\" title=\"Next\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"9 18 15 12 9 6\"></polyline></svg></button>\n</div>\n<h2 id=\"df-title\"></h2>\n<div id=\"df-date\" class=\"feed-date\"></div>\n<div id=\"df-body\"></div>\n<p id=\"df-linkp\" style=\"display:none\"><a id=\"df-link\" href=\"#\">Open source</a></p>\n</div>\n<p id=\"df-note\" style=\"display:none\">Stored feed could not be read.</p>\n</div>\n<style>\n\n.feed-nav { display: grid; grid-template-columns: auto 1fr auto; align-items: center; margin: 12px 0 12px 0; }\n.feed-nav button { display: flex; align-items: center; justify-content: center; }\n\n\n#df-pos { font-size: 18px; text-align: center; white-space: pre-wrap; padding: 0 12px; }\n/* Empty page: no bundle font or sizing of its own, so it reads\n * like the Help app, which carries no bundle CSS and lets the\n * shell theme style its prose, headings, and code. */\n#df-title { font-size: 20px; margin: 16px 0 4px 0; }\n.feed-date { font-size: 14px; margin: 0 0 12px 0; }\n#df-body { white-space: pre-wrap; word-wrap: break-word; overflow-wrap: break-word; font-size: 18px; line-height: 1.4; margin: 0; }\n#df-body p { margin: 0 0 12px 0; white-space: pre-wrap; }\n#df-body a, #df-link { color: #000; text-decoration: underline; overflow-wrap: break-word; word-break: break-all; }\n#df-note { font-size: 18px; }\n</style>\n<script>\n/* Daily Feed viewer. Read-only: no act() calls, no fetch, no\n * copy control, no localStorage. State is read from the JSON\n * seed the shell renders before this bundle (bridge path), with\n * the shell span readout as fallback. Pure functions are defined\n * first so Node tests can load this script without a DOM and call\n * them directly; DOM wiring is guarded by typeof document. */\nfunction dfEscape(text) {\n  return String(text).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\").replace(/\"/g, \"&quot;\").replace(/'/g, \"&#39;\");\n}\nfunction dfUnescape(text) {\n  return String(text).replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\").replace(/&quot;/g, '\"').replace(/&apos;/g, \"'\").replace(/&#39;/g, \"'\").replace(/&#x27;/g, \"'\").replace(/&amp;/g, \"&\");\n}\nfunction dfStripPunct(url) {\n  var punct = \"\";\n  while (url.length > 0) {\n    var last = url.charAt(url.length - 1);\n    if (last === \".\" || last === \",\" || last === \";\" || last === \":\" || last === \"!\" || last === \"?\" || last === \")\" || last === \"]\") {\n      punct = last + punct;\n      url = url.slice(0, -1);\n    } else {\n      break;\n    }\n  }\n  return [url, punct];\n}\nfunction dfLinkify(escapedText) {\n  var re = /Source:\\s*(https?:\\/\\/[^\\s<]+)|(https?:\\/\\/[^\\s<]+)/g;\n  return escapedText.replace(re, function (match, sourceUrl, bareUrl) {\n    var raw = sourceUrl || bareUrl;\n    var parts = dfStripPunct(raw);\n    var clean = parts[0];\n    var punct = parts[1];\n    if (sourceUrl) {\n      return '<a href=\"' + clean + '\">Source</a>' + punct;\n    }\n    return '<a href=\"' + clean + '\">' + clean + '</a>' + punct;\n  });\n}\nfunction dfTagValue(block, tag) {\n  var re = new RegExp(\"<\" + tag + \"[^>]*>([\\\\s\\\\S]*?)</\" + tag + \">\");\n  var m = re.exec(block);\n  if (!m) { return \"\"; }\n  var v = m[1];\n  if (v.indexOf(\"<![CDATA[\") === 0) { v = v.slice(9); }\n  if (v.slice(-3) === \"]]>\") { v = v.slice(0, -3); }\n  return dfUnescape(v);\n}\nfunction dfParseFeedRegex(text) {\n  var items = [];\n  var re = /<item>([\\s\\S]*?)<\\/item>/g;\n  var m;\n  while ((m = re.exec(text)) !== null) {\n    var block = m[1];\n    items.push({\n      title: dfTagValue(block, \"title\"),\n      link: dfTagValue(block, \"link\"),\n      guid: dfTagValue(block, \"guid\"),\n      pubDate: dfTagValue(block, \"pubDate\"),\n      description: dfTagValue(block, \"description\") || dfTagValue(block, \"content:encoded\")\n    });\n  }\n  return items;\n}\nfunction dfFormatPubDate(raw) {\n  if (!raw) { return \"\"; }\n  var d = new Date(raw);\n  if (isNaN(d.getTime())) { return \"\"; }\n  return d.toLocaleDateString(undefined, { weekday: \"long\", year: \"numeric\", month: \"long\", day: \"numeric\" });\n}\nfunction dfIsWellFormedFeed(text) {\n  if (text.indexOf(\"<rss\") !== -1) { return true; }\n  if (text.indexOf(\"<channel\") !== -1) { return true; }\n  if (text.indexOf(\"<feed\") !== -1) { return true; }\n  return false;\n}\nfunction dfParseFeed(text, domParser) {\n  var feed = String(text || \"\");\n  if (feed.trim() === \"\") { return { items: [], status: \"empty\" }; }\n  var items = [];\n  var parsedByDom = false;\n  if (domParser) {\n    try {\n      var doc = domParser.parseFromString(feed, \"text/xml\");\n      var errors = doc.getElementsByTagName(\"parsererror\");\n      if (!errors || errors.length === 0) {\n        var els = doc.getElementsByTagName(\"item\");\n        var i, el;\n        for (i = 0; i < els.length; i++) {\n          el = els[i];\n          items.push({\n            title: dfDomChild(el, \"title\"),\n            link: dfDomChild(el, \"link\"),\n            guid: dfDomChild(el, \"guid\"),\n            pubDate: dfDomChild(el, \"pubDate\"),\n            description: dfDomChild(el, \"description\") || dfDomChild(el, \"content:encoded\")\n          });\n        }\n        parsedByDom = true;\n      }\n    } catch (err) {\n      parsedByDom = false;\n    }\n  }\n  if (!parsedByDom) {\n    items = dfParseFeedRegex(feed);\n    if (items.length === 0 && !dfIsWellFormedFeed(feed)) {\n      return { items: [], status: \"unparseable\" };\n    }\n  }\n  items.reverse();\n  return { items: items, status: \"ok\" };\n}\nfunction dfDomChild(parent, tag) {\n  var i, node;\n  for (i = 0; i < parent.childNodes.length; i++) {\n    node = parent.childNodes[i];\n    if (node.nodeType === 1 && node.nodeName === tag) {\n      return node.textContent || \"\";\n    }\n  }\n  return \"\";\n}\nif (typeof document !== \"undefined\" && document.getElementById) {\n  (function () {\n    var viewer = document.getElementById(\"df-viewer\");\n    var promptEl = document.getElementById(\"df-prompt\");\n    var noteEl = document.getElementById(\"df-note\");\n    var prevBtn = document.getElementById(\"df-prev\");\n    var nextBtn = document.getElementById(\"df-next\");\n    var posEl = document.getElementById(\"df-pos\");\n    var titleEl = document.getElementById(\"df-title\");\n    var dateEl = document.getElementById(\"df-date\");\n    var bodyEl = document.getElementById(\"df-body\");\n    var linkP = document.getElementById(\"df-linkp\");\n    var linkA = document.getElementById(\"df-link\");\n    var items = [];\n    var index = 0;\n    function readFeed() {\n      var feed = \"\";\n      try {\n        if (typeof window !== \"undefined\" && window.KodyBridge) {\n          var scriptEl = null;\n          try { scriptEl = document.currentScript; } catch (err) { scriptEl = null; }\n          var section = null;\n          var el = scriptEl;\n          while (el) {\n            if (el.getAttribute && el.getAttribute(\"data-app-id\")) { section = el; break; }\n            el = el.parentNode;\n          }\n          if (!section) {\n            var sections = document.querySelectorAll(\"section[data-app-id]\");\n            if (sections.length > 0) { section = sections[0]; }\n          }\n          if (section) {\n            var store = window.KodyBridge.create(section, { fieldTypes: { feed: \"string\" } });\n            var val = store.get(\"feed\");\n            if (typeof val === \"string\") { feed = val; }\n          }\n        }\n      } catch (err) {\n        feed = \"\";\n      }\n      if (!feed) {\n        var seeds = document.querySelectorAll('script[data-kody-state-seed=\"1\"]');\n        var s, parsed;\n        for (s = 0; s < seeds.length; s++) {\n          try {\n            parsed = JSON.parse(seeds[s].textContent);\n            if (parsed && typeof parsed.feed === \"string\") { feed = parsed.feed; break; }\n          } catch (err) { }\n        }\n      }\n      if (!feed) {\n        var p = document.querySelector('p[data-field=\"feed\"]');\n        if (p) {\n          var span = p.querySelector(\"span\");\n          if (span) { feed = span.textContent || \"\"; }\n        }\n      }\n      return feed;\n    }\n    function render() {\n      if (items.length === 0) { return; }\n      var item = items[index];\n      var title = item.title || (\"Entry \" + (index + 1));\n      titleEl.textContent = title;\n      var dateText = dfFormatPubDate(item.pubDate);\n      dateEl.textContent = dateText;\n      var desc = item.description || \"\";\n      var paragraphs = desc.split(/\\n\\s*\\n/);\n      var html = \"\";\n      var i;\n      for (i = 0; i < paragraphs.length; i++) {\n        if (paragraphs[i].trim() === \"\") { continue; }\n        html += \"<p>\" + dfLinkify(dfEscape(paragraphs[i])) + \"</p>\";\n      }\n      if (html === \"\") { html = \"<p></p>\"; }\n      bodyEl.innerHTML = html;\n      if (item.link && (item.link.indexOf(\"http://\") === 0 || item.link.indexOf(\"https://\") === 0)) {\n        linkA.setAttribute(\"href\", item.link);\n        linkP.style.display = \"\";\n      } else {\n        linkP.style.display = \"none\";\n      }\n      posEl.textContent = (dateText || title) + \"\\n\" + (index + 1) + \" of \" + items.length;\n      prevBtn.disabled = index <= 0;\n      nextBtn.disabled = index >= items.length - 1;\n    }\n    function init() {\n      var feed = readFeed();\n      var result = dfParseFeed(feed, (typeof DOMParser !== \"undefined\") ? new DOMParser() : null);\n      if (result.status === \"empty\" || result.items.length === 0) {\n        viewer.style.display = \"none\";\n        promptEl.style.display = \"\";\n        if (result.status === \"unparseable\") {\n          noteEl.style.display = \"\";\n        } else {\n          noteEl.style.display = \"none\";\n        }\n        return;\n      }\n      items = result.items;\n      index = items.length - 1;\n      promptEl.style.display = \"none\";\n      noteEl.style.display = \"none\";\n      viewer.style.display = \"\";\n      render();\n      prevBtn.addEventListener(\"click\", function () {\n        if (index > 0) { index = index - 1; render(); }\n      });\n      nextBtn.addEventListener(\"click\", function () {\n        if (index < items.length - 1) { index = index + 1; render(); }\n      });\n    }\n    if (document.readyState === \"complete\" || document.readyState === \"interactive\") {\n      init();\n    } else {\n      document.addEventListener(\"DOMContentLoaded\", init);\n    }\n  })();\n}\n</script>\n"
    }
  },
  "ui": {
    "title": "Daily Feed",
    "hideState": true,
    "placements": [
      "page"
    ]
  },
  "stateSchema": {
    "type": "object",
    "initial": {
      "feed": ""
    },
    "fields": {
      "feed": {
        "type": "string",
        "maxLength": 250000
      }
    }
  },
  "actions": {
    "set_feed": {
      "description": "Set the full RSS feed XML, newest first, at most 14 entries.",
      "args": {
        "value": {
          "type": "string",
          "required": true,
          "maxLength": 250000
        }
      },
      "effects": [
        {
          "op": "set",
          "field": "feed",
          "fromArg": "value"
        }
      ]
    }
  }
}
