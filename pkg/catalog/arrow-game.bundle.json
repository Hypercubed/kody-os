{
  "id": "arrow-game",
  "name": "Arrow Game",
  "label": "Arrow Game",
  "schemaVersion": 5,
  "catalogVersion": 1,
  "icon": "→",
  "category": "Games",
  "description": "MVP rewrite of Hypercubed/arrow-game in vanilla ES2019: remove the blue arrows, red arrows are blocked and cost a life, a life every 5 levels, checkpoint fallback. Cuts vs the original: no animations, no timer or speed meter, no keyboard skip; tap to remove, drag is best-effort.",
  "bundle": {
    "entry": "index.html",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<style>\n.ag-wrap { font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; color: #111; background: #fff; padding: 16px; max-width: 520px; margin: 0 auto; }\n.ag-stats { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 12px; }\n.ag-stat { border: 2px solid #111; padding: 8px; text-align: center; }\n.ag-stat b { display: block; font-size: 24px; }\n.ag-msg { min-height: 24px; text-align: center; font-weight: 600; margin: 0 0 12px 0; }\n.ag-board { display: grid; gap: 8px; margin-bottom: 12px; }\n.ag-cell { min-height: 0; font-size: 28px; border: 2px solid #111; background: #fff; color: #111; cursor: pointer; padding: 0; aspect-ratio: 1; }\n.ag-cell.safe { background: #dbeafe; border-color: #2563eb; color: #1e40af; }\n.ag-cell.blocked { background: #fee2e2; border-color: #dc2626; color: #991b1b; }\n.ag-cell.empty { border-color: #ddd; cursor: default; }\n.ag-row { display: flex; gap: 8px; margin-bottom: 8px; }\n.ag-btn { flex: 1; font-family: inherit; font-size: 17px; min-height: 48px; border: 2px solid #111; background: #fff; color: #111; cursor: pointer; padding: 8px; }\n.ag-note { font-size: 13px; color: #444; }\n</style>\n</head>\n<body>\n<div class=\"ag-wrap\">\n<div class=\"ag-stats\">\n<div class=\"ag-stat\">Level<b id=\"ag-level\">1</b></div>\n<div class=\"ag-stat\">Lives<b id=\"ag-lives\">0</b></div>\n<div class=\"ag-stat\">Removed<b id=\"ag-removed\">0</b></div>\n</div>\n<p class=\"ag-msg\" id=\"ag-msg\">Remove the blue arrows. Red arrows are blocked and cost a life.</p>\n<div class=\"ag-board\" id=\"ag-board\"></div>\n<div class=\"ag-row\">\n<button type=\"button\" class=\"ag-btn\" id=\"ag-reset\">Reset board (1 life)</button>\n<button type=\"button\" class=\"ag-btn\" id=\"ag-new\">New game</button>\n</div>\n<p class=\"ag-note\">A kody-os rewrite of <a href=\"https://github.com/Hypercubed/arrow-game\" target=\"_blank\" rel=\"noopener\">Hypercubed/arrow-game</a> on GitHub.</p>\n</div>\n<script>\nvar agScript = null;\ntry { agScript = document.currentScript; } catch (err) { agScript = null; }\nvar agSection = null;\n(function () {\n  var el = agScript;\n  while (el) {\n    if (el.getAttribute && el.getAttribute('data-app-id')) { agSection = el; break; }\n    el = el.parentNode;\n  }\n  if (!agSection) {\n    var secs = document.querySelectorAll('section[data-app-id]');\n    if (secs.length > 0) { agSection = secs[0]; }\n  }\n})();\nvar agStore = null;\nvar agState = { board: 'U', level: 1, lives: 0, removed: 0 };\nvar agOver = false;\nvar agDragging = false;\nvar agGesture = {};\nvar agLastBoard = '';\nfunction agGridSize(level) { return Math.ceil(Math.sqrt(level)); }\nfunction agDirChar(d) {\n  if (d === 'up') { return '↑'; }\n  if (d === 'down') { return '↓'; }\n  if (d === 'left') { return '←'; }\n  return '→';\n}\nfunction agBlocked(list, one) {\n  var i, o;\n  for (i = 0; i < list.length; i++) {\n    o = list[i];\n    if (o.id === one.id) { continue; }\n    if (one.dir === 'up' && o.col === one.col && o.row < one.row) { return true; }\n    if (one.dir === 'down' && o.col === one.col && o.row > one.row) { return true; }\n    if (one.dir === 'left' && o.row === one.row && o.col < one.col) { return true; }\n    if (one.dir === 'right' && o.row === one.row && o.col > one.col) { return true; }\n  }\n  return false;\n}\nfunction agParseBoard(board, size) {\n  var list = [], i, ch, dir;\n  for (i = 0; i < board.length; i++) {\n    ch = board.charAt(i);\n    if (ch === '.') { continue; }\n    if (ch === 'U') { dir = 'up'; }\n    else if (ch === 'D') { dir = 'down'; }\n    else if (ch === 'L') { dir = 'left'; }\n    else { dir = 'right'; }\n    list.push({ id: i, row: Math.floor(i / size), col: i % size, dir: dir });\n  }\n  return list;\n}\nfunction agEncodeBoard(list, size) {\n  var cells = [], i, a;\n  for (i = 0; i < size * size; i++) { cells.push('.'); }\n  for (i = 0; i < list.length; i++) {\n    a = list[i];\n    cells[a.row * size + a.col] = a.dir === 'up' ? 'U' : (a.dir === 'down' ? 'D' : (a.dir === 'left' ? 'L' : 'R'));\n  }\n  return cells.join('');\n}\nfunction agSolvable(list) {\n  var remaining = list.slice(), i, removable, guard;\n  guard = 0;\n  while (remaining.length > 0 && guard < list.length * 2 + 10) {\n    guard += 1;\n    removable = [];\n    for (i = 0; i < remaining.length; i++) {\n      if (!agBlocked(remaining, remaining[i])) { removable.push(remaining[i]); }\n    }\n    if (removable.length === 0) { return false; }\n    for (i = 0; i < remaining.length; i++) {\n      if (remaining[i].id === removable[0].id) { remaining.splice(i, 1); break; }\n    }\n  }\n  return remaining.length === 0;\n}\nfunction agGenerate(level) {\n  var size = agGridSize(level), dirs = ['up', 'down', 'left', 'right'], attempt, list, i, r, c;\n  for (attempt = 0; attempt < 50; attempt++) {\n    list = [];\n    for (i = 0; i < level; i++) {\n      r = Math.floor(i / size); c = i % size;\n      list.push({ id: i, row: r, col: c, dir: dirs[Math.floor(Math.random() * 4)] });\n    }\n    if (agSolvable(list)) { return agEncodeBoard(list, size); }\n  }\n  list = [];\n  for (i = 0; i < level; i++) {\n    r = Math.floor(i / size); c = i % size;\n    if (r === 0) { list.push({ id: i, row: r, col: c, dir: 'up' }); }\n    else if (r === size - 1) { list.push({ id: i, row: r, col: c, dir: 'down' }); }\n    else if (c === 0) { list.push({ id: i, row: r, col: c, dir: 'left' }); }\n    else if (c === size - 1) { list.push({ id: i, row: r, col: c, dir: 'right' }); }\n    else { list.push({ id: i, row: r, col: c, dir: dirs[Math.floor(Math.random() * 4)] }); }\n  }\n  return agEncodeBoard(list, size);\n}\nfunction agSquare() {\n  var board = document.getElementById('ag-board');\n  if (!board) { return; }\n  for (var i = 0; i < board.childNodes.length; i++) {\n    var c = board.childNodes[i];\n    if (c.offsetWidth > 0) { c.style.height = c.offsetWidth + 'px'; }\n  }\n}\nfunction agSetMsg(text) {\n  var el = document.getElementById('ag-msg');\n  if (el) { el.textContent = text; }\n}\nfunction agRebase(server, pending, sent) { return { args: pending, optimistic: pending }; }\nfunction agSave(next) {\n  agState = { board: next.board, level: next.level, lives: next.lives, removed: next.removed };\n  agRender();\n  if (agStore) { agStore.dispatch('save', agState, agState, agRebase); }\n}\nfunction agLoseLife() {\n  if (agState.lives > 0) {\n    agSave({ board: agState.board, level: agState.level, lives: agState.lives - 1, removed: agState.removed });\n    return true;\n  }\n  var checkpoint = Math.floor(agState.level / 5) * 5;\n  if (checkpoint === 0) {\n    agOver = true;\n    agSetMsg('Game over. Final level: ' + agState.level + '. Press New game.');\n    agRender();\n    return false;\n  }\n  agOver = false;\n  agSave({ board: agGenerate(checkpoint), level: checkpoint, lives: Math.floor(checkpoint / 5), removed: agState.removed });\n  agSetMsg('Back to checkpoint level ' + checkpoint + '.');\n  return true;\n}\nfunction agProcess(id) {\n  var size, list, target, i, next;\n  if (agOver) { return; }\n  if (agGesture[id]) { return; }\n  agGesture[id] = true;\n  size = agGridSize(agState.level);\n  list = agParseBoard(agState.board, size);\n  target = null;\n  for (i = 0; i < list.length; i++) {\n    if (list[i].id === id) { target = list[i]; break; }\n  }\n  if (!target) { return; }\n  if (agBlocked(list, target)) {\n    agSetMsg('That arrow is blocked. Minus 1 life.');\n    agLoseLife();\n    return;\n  }\n  next = [];\n  for (i = 0; i < list.length; i++) {\n    if (list[i].id !== id) { next.push(list[i]); }\n  }\n  if (next.length === 0) {\n    var nl = agState.level + 1;\n    var nv = agState.lives + (nl % 5 === 0 ? 1 : 0);\n    agSetMsg(nl % 5 === 0 ? 'Level complete. Plus 1 life.' : 'Level complete.');\n    agSave({ board: agGenerate(nl), level: nl, lives: nv, removed: agState.removed + 1 });\n    return;\n  }\n  agSave({ board: agEncodeBoard(next, size), level: agState.level, lives: agState.lives, removed: agState.removed + 1 });\n}\nfunction agRender() {\n  var size = agGridSize(agState.level);\n  var lv = document.getElementById('ag-level');\n  var li = document.getElementById('ag-lives');\n  var rm = document.getElementById('ag-removed');\n  if (lv) { lv.textContent = String(agState.level); }\n  if (li) { li.textContent = String(agState.lives); }\n  if (rm) { rm.textContent = String(agState.removed); }\n  if (agState.board === agLastBoard && !agOver) {\n    var boardEl = document.getElementById('ag-board');\n    if (boardEl && boardEl.childNodes.length > 0) { return; }\n  }\n  agLastBoard = agState.board;\n  var board = document.getElementById('ag-board');\n  if (!board) { return; }\n  board.style.gridTemplateColumns = 'repeat(' + size + ', 1fr)';\n  board.style.maxWidth = Math.min(520, size * 96 + (size - 1) * 8) + 'px';\n  board.style.marginLeft = 'auto';\n  board.style.marginRight = 'auto';\n  while (board.firstChild) { board.removeChild(board.firstChild); }\n  var list = agParseBoard(agState.board, size);\n  var i, r, c, arrow, cell, btn;\n  for (i = 0; i < size * size; i++) {\n    r = Math.floor(i / size); c = i % size;\n    arrow = null;\n    for (var j = 0; j < list.length; j++) {\n      if (list[j].row === r && list[j].col === c) { arrow = list[j]; break; }\n    }\n    if (!arrow) {\n      cell = document.createElement('div');\n      cell.className = 'ag-cell empty';\n      board.appendChild(cell);\n      continue;\n    }\n    btn = document.createElement('button');\n    btn.type = 'button';\n    btn.className = 'ag-cell ' + (agBlocked(list, arrow) ? 'blocked' : 'safe');\n    btn.textContent = agDirChar(arrow.dir);\n    btn.setAttribute('data-id', String(arrow.id));\n    (function (aid, b) {\n      b.addEventListener('click', function () { agProcess(aid); });\n      b.addEventListener('mousedown', function () { agDragging = true; agGesture = {}; });\n      b.addEventListener('mouseenter', function (e) {\n        if (agDragging && e.buttons === 1) { agProcess(aid); }\n      });\n      b.addEventListener('touchstart', function () { agDragging = true; agGesture = {}; });\n    })(arrow.id, btn);\n    board.appendChild(btn);\n  }\n  agSquare();\n}\nfunction agInit() {\n  if (window.KodyBridge && agSection) {\n    agStore = window.KodyBridge.create(agSection, {\n      fieldTypes: { board: 'string', level: 'integer', lives: 'integer', removed: 'integer' },\n      reassert: function (desired) { return { action: 'save', args: desired, optimistic: desired, rebase: agRebase }; }\n    });\n    agStore.subscribe(function (snap) {\n      var d = snap.desired;\n      if (d && typeof d.board === 'string') {\n        agState = { board: d.board, level: d.level || 1, lives: d.lives || 0, removed: d.removed || 0 };\n        agRender();\n      }\n    });\n    agStore.startSpanObserver();\n    var cur = agStore.getState().desired;\n    if (cur && typeof cur.board === 'string') {\n      agState = { board: cur.board, level: cur.level || 1, lives: cur.lives || 0, removed: cur.removed || 0 };\n    }\n  } else {\n    var seed = null;\n    var scripts = document.querySelectorAll('script[data-kody-state-seed]');\n    for (var s = 0; s < scripts.length; s++) {\n      try { seed = JSON.parse(scripts[s].textContent); } catch (err) { seed = null; }\n      if (seed) { break; }\n    }\n    if (seed && typeof seed.board === 'string') {\n      agState = { board: seed.board, level: seed.level || 1, lives: seed.lives || 0, removed: seed.removed || 0 };\n    }\n  }\n  window.addEventListener('resize', function () { agSquare(); });\n  document.addEventListener('mouseup', function () { agDragging = false; agGesture = {}; });\n  document.addEventListener('touchend', function () {\n    agDragging = false;\n    setTimeout(function () { agGesture = {}; }, 300);\n  });\n  var boardBox = document.getElementById('ag-board');\n  if (boardBox) {\n    boardBox.addEventListener('touchmove', function (e) {\n      if (!agDragging) { return; }\n      var t = e.touches[0];\n      var el = document.elementFromPoint(t.clientX, t.clientY);\n      while (el && !el.getAttribute('data-id')) { el = el.parentNode; }\n      if (el && el.getAttribute('data-id')) { agProcess(parseInt(el.getAttribute('data-id'), 10)); }\n    });\n  }\n  var rb = document.getElementById('ag-reset');\n  if (rb) {\n    rb.addEventListener('click', function () {\n      if (agOver) { return; }\n      agSetMsg('Board reset. Minus 1 life.');\n      if (agLoseLife()) {\n        if (!agOver) { agSave({ board: agGenerate(agState.level), level: agState.level, lives: agState.lives, removed: agState.removed }); }\n      }\n    });\n  }\n  var nb = document.getElementById('ag-new');\n  if (nb) {\n    nb.addEventListener('click', function () {\n      agOver = false;\n      agSetMsg('Remove the blue arrows. Red arrows are blocked and cost a life.');\n      agSave({ board: agGenerate(1), level: 1, lives: 0, removed: 0 });\n    });\n  }\n  agRender();\n}\nif (document.readyState === 'loading') {\n  document.addEventListener('DOMContentLoaded', agInit);\n} else {\n  agInit();\n}\n</script>\n</body>\n</html>\n"
    }
  },
