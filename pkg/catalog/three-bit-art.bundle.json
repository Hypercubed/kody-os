{
  "id": "three-bit-art",
  "name": "3-Bit Art",
  "label": "3-Bit Art",
  "schemaVersion": 5,
  "icon": "◼",
  "category": "Art",
  "description": "MVP rewrite of Hypercubed/3-bit-art in vanilla ES2019: 16 by 16 drawing with a saved Pattern/Color toggle (default Pattern): Pattern shows 8 black-and-white 32 by 32 Bayer ordered-dither tiles with density set by ITU-R BT.709 luma of the standard 3-bit RGB color (chosen for Kindle legibility, so pixels read as greyscale tones); Color shows solid 3-bit RGB cube colors. No device detection (colorDepth reports 24-bit and the monochrome query is false on the Scribe); the mode is saved in state. Gallery of up to 12 drawings. Cuts vs the original: no canvas (div grid with SVG background tiles instead), no Angular/Material, drawing stored as a 256-digit string rather than 128-character base64 bit packing, no PNG or PXON export, no URL-hash sharing.",
  "bundle": {
    "entry": "index.html",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<style>\n.tb-wrap { font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; color: #111; background: #fff; padding: 16px; max-width: 520px; margin: 0 auto; }\n.tb-grid { display: grid; gap: 2px; background: #888; border: 2px solid #111; margin-bottom: 12px; }\n.tb-cell { height: auto; min-height: 0; border: 0; padding: 0; cursor: pointer; aspect-ratio: 1; background-size: 100% 100%; background-repeat: no-repeat; }\n.tb-row { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }\n.tb-btn { flex: 1; font-family: inherit; font-size: 16px; min-height: 48px; border: 2px solid #111; background: #fff; color: #111; cursor: pointer; padding: 8px; }\n.tb-btn.on { outline: 4px solid #111; outline-offset: -4px; }\n.tb-pal { width: 48px; height: 48px; border: 2px solid #111; cursor: pointer; padding: 0; background-size: 100% 100%; background-repeat: no-repeat; }\n.tb-pal.on { outline: 4px solid #111; outline-offset: -4px; }\n.tb-msg { min-height: 24px; font-weight: 600; margin: 0 0 8px 0; }\n.tb-gal { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }\n.tb-item { border: 2px solid #111; padding: 6px; text-align: center; }\n.tb-thumb { display: grid; gap: 0; width: 128px; margin-bottom: 6px; }\n.tb-px { width: 8px; height: 8px; }\n.tb-note { font-size: 13px; color: #444; }\n</style>\n</head>\n<body>\n<div class=\"tb-wrap\">\n<p class=\"tb-msg\" id=\"tb-msg\">Tap the canvas to paint. Eight dither patterns, 16 by 16 pixels.</p>\n<div class=\"tb-grid\" id=\"tb-grid\"></div>\n<div class=\"tb-row\" id=\"tb-palette\"></div>\n<div class=\"tb-row\">\n<button type=\"button\" class=\"tb-btn tb-mode on\" data-mode=\"pattern\">Pattern</button>\n<button type=\"button\" class=\"tb-btn tb-mode\" data-mode=\"color\">Color</button>\n</div>\n<div class=\"tb-row\">\n<button type=\"button\" class=\"tb-btn\" id=\"tb-save\">Save to gallery</button>\n<button type=\"button\" class=\"tb-btn\" id=\"tb-clear\">Clear</button>\n</div>\n<div class=\"tb-gal\" id=\"tb-gallery\"></div>\n<p class=\"tb-note\">A kody-os rewrite of <a href=\"https://github.com/Hypercubed/3-bit-art\" target=\"_blank\" rel=\"noopener\">Hypercubed/3-bit-art</a> on GitHub.</p>\n</div>\n<script>\nvar tbScript = null;\ntry { tbScript = document.currentScript; } catch (err) { tbScript = null; }\nvar tbSection = null;\n(function () {\n  var el = tbScript;\n  while (el) {\n    if (el.getAttribute && el.getAttribute('data-app-id')) { tbSection = el; break; }\n    el = el.parentNode;\n  }\n  if (!tbSection) {\n    var secs = document.querySelectorAll('section[data-app-id]');\n    if (secs.length > 0) { tbSection = secs[0]; }\n  }\n})();\n// Standard 1: Bayer ordered dithering (Bayer, 1973). Recursive threshold matrix:\n//   M(2n) = [[4*M(n), 4*M(n)+2], [4*M(n)+3, 4*M(n)+1]], M(1) = [[0]],\n//   so the 2x2 base is [[0, 2], [3, 1]]. A 32x32 matrix gives 1025 density\n//   steps, and the dot order is dispersed (no clustering), which is what\n//   makes a tile read as grey rather than as a visible pattern.\n// Standard 2: color to grey by ITU-R BT.709 luma, Y = 0.2126*R + 0.7152*G\n//   + 0.0722*B, over the standard 3-bit RGB cube: R = value bit 0, G =\n//   bit 1, B = bit 2, each channel 0 or 255. A value's tile has\n//   blackCount = round((1 - Y/255) * 1024) black dots, placed in Bayer\n//   order (lowest threshold first). Tiles are generated in-bundle as SVG\n//   data URIs (no external fetch, no canvas), one div per logical pixel,\n//   so DOM size does not grow with tile resolution. The cell's\n//   background-color is the same luma grey, so if a browser fails to\n//   render the SVG background it still shows the correct grey, not white.\nvar TB_TILE = 32;\nvar TB_LUM = [0, 54, 182, 237, 18, 73, 201, 255];\nvar TB_BLACK = [1024, 806, 292, 74, 950, 732, 218, 0];\nfunction tbBayer32() {\n  var m = [[0]], size = 1, next, r, c, base;\n  while (size < 32) {\n    next = [];\n    for (r = 0; r < size * 2; r++) {\n      next[r] = [];\n      for (c = 0; c < size * 2; c++) {\n        base = m[r % size][c % size];\n        if (r < size && c < size) { next[r][c] = 4 * base; }\n        else if (r < size) { next[r][c] = 4 * base + 2; }\n        else if (c < size) { next[r][c] = 4 * base + 3; }\n        else { next[r][c] = 4 * base + 1; }\n      }\n    }\n    m = next;\n    size = size * 2;\n  }\n  return m;\n}\nvar TB_BAYER32 = tbBayer32();\nfunction tbTileUri(value) {\n  var count = TB_BLACK[value];\n  var svg = \"<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'>\";\n  if (count >= 1024) {\n    svg += \"<rect width='32' height='32' fill='black'/>\";\n  } else {\n    svg += \"<rect width='32' height='32' fill='white'/>\";\n    var r, c;\n    for (r = 0; r < 32; r++) {\n      for (c = 0; c < 32; c++) {\n        if (TB_BAYER32[r][c] < count) {\n          svg += \"<rect x='\" + c + \"' y='\" + r + \"' width='1' height='1' fill='black'/>\";\n        }\n      }\n    }\n  }\n  svg += '</svg>';\n  return 'url(\"data:image/svg+xml,' + encodeURIComponent(svg) + '\")';\n}\nvar TB_TILES = (function () {\n  var out = [], v;\n  for (v = 0; v < 8; v++) { out.push(tbTileUri(v)); }\n  return out;\n})();\nfunction tbGrey(v) {\n  var g = TB_LUM[v] || 0;\n  return 'rgb(' + g + ',' + g + ',' + g + ')';\n}\nvar tbStore = null;\nvar tbState = { data: '', gallery: '', mode: 'pattern' };\n// Color mode uses the standard 3-bit RGB cube, same bit order as the luma\n// mapping (R = bit 0, G = bit 1, B = bit 2). Mode is saved in state, so a\n// color display stays in color and the Scribe stays in pattern, with no\n// device detection: colorDepth reports 24-bit and the monochrome media\n// query is false on the Scribe, so neither can tell the two apart.\nvar TB_COLORS = ['#000000', '#ff0000', '#00ff00', '#ffff00', '#0000ff', '#ff00ff', '#00ffff', '#ffffff'];\nvar tbColor = 1;\nvar tbDragging = false;\nvar tbLastData = '';\nvar tbLastGallery = '';\nvar tbLastMode = '';\nfunction tbEmptyData() {\n  var s = '', i;\n  for (i = 0; i < 256; i++) { s += '7'; }\n  return s;\n}\nfunction tbSquare() {\n  var grid = document.getElementById('tb-grid');\n  if (!grid) { return; }\n  for (var i = 0; i < grid.childNodes.length; i++) {\n    var c = grid.childNodes[i];\n    if (c.offsetWidth > 0) { c.style.height = c.offsetWidth + 'px'; }\n  }\n}\nfunction tbRebase(server, pending, sent) { return { args: pending, optimistic: pending }; }\nfunction tbSave(next) {\n  tbState = { data: next.data, gallery: next.gallery, mode: next.mode || tbState.mode || 'pattern' };\n  tbRender();\n  if (tbStore) { tbStore.dispatch('save', tbState, tbState, tbRebase); }\n}\nfunction tbSetMsg(text) {\n  var el = document.getElementById('tb-msg');\n  if (el) { el.textContent = text; }\n}\nfunction tbPaint(idx) {\n  var cells = tbState.data.split('');\n  cells[idx] = String(tbColor);\n  tbSave({ data: cells.join(''), gallery: tbState.gallery });\n}\nfunction tbPaintCell(cell, value) {\n  if (tbState.mode === 'color') {\n    cell.style.backgroundColor = TB_COLORS[value] || '#ffffff';\n    cell.style.backgroundImage = '';\n  } else {\n    cell.style.backgroundColor = tbGrey(value);\n    cell.style.backgroundImage = TB_TILES[value] || '';\n  }\n}\nfunction tbRenderGrid() {\n  var grid = document.getElementById('tb-grid');\n  if (!grid) { return; }\n  if (grid.childNodes.length === 256) {\n    for (var i = 0; i < 256; i++) {\n      tbPaintCell(grid.childNodes[i], parseInt(tbState.data.charAt(i), 10) || 0);\n    }\n    return;\n  }\n  grid.style.gridTemplateColumns = 'repeat(16, 1fr)';\n  while (grid.firstChild) { grid.removeChild(grid.firstChild); }\n  for (var j = 0; j < 256; j++) {\n    var cell = document.createElement('div');\n    cell.className = 'tb-cell';\n    cell.setAttribute('data-idx', String(j));\n    cell.setAttribute('role', 'button');\n    cell.setAttribute('tabindex', '0');\n    tbPaintCell(cell, parseInt(tbState.data.charAt(j), 10) || 0);\n    (function (idx, c) {\n      c.addEventListener('click', function () { tbPaint(idx); });\n      c.addEventListener('mousedown', function () { tbDragging = true; tbPaint(idx); });\n      c.addEventListener('mouseenter', function (e) {\n        if (tbDragging && e.buttons === 1) { tbPaint(idx); }\n      });\n      c.addEventListener('touchstart', function () { tbDragging = true; });\n    })(j, cell);\n    grid.appendChild(cell);\n  }\n}\nfunction tbRenderGallery() {\n  var gal = document.getElementById('tb-gallery');\n  if (!gal) { return; }\n  while (gal.firstChild) { gal.removeChild(gal.firstChild); }\n  if (!tbState.gallery) { return; }\n  var items = tbState.gallery.split('|');\n  for (var k = 0; k < items.length; k++) {\n    (function (idx, drawing) {\n      var item = document.createElement('div');\n      item.className = 'tb-item';\n      var thumb = document.createElement('div');\n      thumb.className = 'tb-thumb';\n      thumb.style.gridTemplateColumns = 'repeat(16, 1fr)';\n      for (var p = 0; p < 256 && p < drawing.length; p++) {\n        var px = document.createElement('div');\n        px.className = 'tb-px';\n        if (tbState.mode === 'color') { px.style.backgroundColor = TB_COLORS[parseInt(drawing.charAt(p), 10) || 0] || '#ffffff'; }\n        else { px.style.backgroundColor = tbGrey(parseInt(drawing.charAt(p), 10) || 0); }\n        thumb.appendChild(px);\n      }\n      var load = document.createElement('button');\n      load.type = 'button';\n      load.className = 'tb-btn';\n      load.textContent = 'Load';\n      load.addEventListener('click', function () {\n        tbSetMsg('Loaded drawing ' + (idx + 1) + ' from the gallery.');\n        tbSave({ data: drawing, gallery: tbState.gallery });\n      });\n      var del = document.createElement('button');\n      del.type = 'button';\n      del.className = 'tb-btn';\n      del.textContent = 'Delete';\n      del.addEventListener('click', function () {\n        var rest = tbState.gallery.split('|');\n        rest.splice(idx, 1);\n        tbSetMsg('Deleted drawing ' + (idx + 1) + '.');\n        tbSave({ data: tbState.data, gallery: rest.join('|') });\n      });\n      item.appendChild(thumb);\n      item.appendChild(load);\n      item.appendChild(del);\n      gal.appendChild(item);\n    })(k, items[k]);\n  }\n}\nfunction tbRender() {\n  if (tbState.data && tbState.data.length === 256) {\n    if (tbState.data !== tbLastData) { tbLastData = tbState.data; }\n    tbRenderGrid();\n  }\n  if (tbState.gallery !== tbLastGallery || tbState.mode !== tbLastMode) {\n    tbLastGallery = tbState.gallery;\n    tbLastMode = tbState.mode;\n    tbRenderGallery();\n  }\n  var pals = document.querySelectorAll('.tb-pal');\n  for (var i = 0; i < pals.length; i++) {\n    var pv = parseInt(pals[i].getAttribute('data-color'), 10) || 0;\n    if (pv === tbColor) { pals[i].className = 'tb-pal on'; }\n    else { pals[i].className = 'tb-pal'; }\n    if (tbState.mode === 'color') {\n      pals[i].style.backgroundColor = TB_COLORS[pv] || '#ffffff';\n      pals[i].style.backgroundImage = '';\n    } else {\n      pals[i].style.backgroundColor = tbGrey(pv);\n      pals[i].style.backgroundImage = TB_TILES[pv] || '';\n    }\n  }\n  var modes = document.querySelectorAll('.tb-mode');\n  for (var m = 0; m < modes.length; m++) {\n    if (modes[m].getAttribute('data-mode') === tbState.mode) { modes[m].className = 'tb-btn tb-mode on'; }\n    else { modes[m].className = 'tb-btn tb-mode'; }\n  }\n  tbSquare();\n}\nfunction tbInit() {\n  if (window.KodyBridge && tbSection) {\n    tbStore = window.KodyBridge.create(tbSection, {\n      fieldTypes: { data: 'string', gallery: 'string' },\n      reassert: function (desired) { return { action: 'save', args: desired, optimistic: desired, rebase: tbRebase }; }\n    });\n    tbStore.subscribe(function (snap) {\n      var d = snap.desired;\n      if (d && typeof d.data === 'string' && d.data.length === 256) {\n        tbState = { data: d.data, gallery: d.gallery || '', mode: d.mode || 'pattern' };\n        tbRender();\n      }\n    });\n    tbStore.startSpanObserver();\n    var cur = tbStore.getState().desired;\n    if (cur && typeof cur.data === 'string' && cur.data.length === 256) {\n      tbState = { data: cur.data, gallery: cur.gallery || '', mode: cur.mode || 'pattern' };\n    }\n  } else {\n    var seed = null;\n    var scripts = document.querySelectorAll('script[data-kody-state-seed]');\n    for (var s = 0; s < scripts.length; s++) {\n      try { seed = JSON.parse(scripts[s].textContent); } catch (err) { seed = null; }\n      if (seed) { break; }\n    }\n    if (seed && typeof seed.data === 'string' && seed.data.length === 256) {\n      tbState = { data: seed.data, gallery: seed.gallery || '', mode: seed.mode || 'pattern' };\n    } else {\n      tbState = { data: tbEmptyData(), gallery: '', mode: 'pattern' };\n    }\n  }\n  if (!tbState.data || tbState.data.length !== 256) { tbState.data = tbEmptyData(); }\n  if (!tbState.mode) { tbState.mode = 'pattern'; }\n  var pal = document.getElementById('tb-palette');\n  if (pal) {\n    for (var c = 0; c < TB_TILES.length; c++) {\n      (function (idx) {\n        var b = document.createElement('div');\n        b.className = idx === tbColor ? 'tb-pal on' : 'tb-pal';\n        b.setAttribute('role', 'button');\n        b.setAttribute('tabindex', '0');\n        b.setAttribute('data-color', String(idx));\n        b.setAttribute('aria-label', 'Pattern ' + idx);\n        if (tbState.mode === 'color') {\n          b.style.backgroundColor = TB_COLORS[idx] || '#ffffff';\n          b.style.backgroundImage = '';\n        } else {\n          b.style.backgroundColor = tbGrey(idx);\n          b.style.backgroundImage = TB_TILES[idx] || '';\n        }\n        b.addEventListener('click', function () { tbColor = idx; tbRender(); });\n        pal.appendChild(b);\n      })(c);\n    }\n  }\n  window.addEventListener('resize', function () { tbSquare(); });\n  document.addEventListener('mouseup', function () { tbDragging = false; });\n  document.addEventListener('touchend', function () { tbDragging = false; });\n  var grid = document.getElementById('tb-grid');\n  if (grid) {\n    grid.addEventListener('touchmove', function (e) {\n      if (!tbDragging) { return; }\n      var t = e.touches[0];\n      var el = document.elementFromPoint(t.clientX, t.clientY);\n      while (el && !el.getAttribute('data-idx')) { el = el.parentNode; }\n      if (el && el.getAttribute('data-idx')) { tbPaint(parseInt(el.getAttribute('data-idx'), 10)); }\n    });\n  }\n  var modes = document.querySelectorAll('.tb-mode');\n  for (var mi = 0; mi < modes.length; mi++) {\n    (function (b) {\n      b.addEventListener('click', function () {\n        var nm = b.getAttribute('data-mode');\n        if (nm === tbState.mode) { return; }\n        tbLastGallery = '';\n        tbSave({ data: tbState.data, gallery: tbState.gallery, mode: nm });\n      });\n    })(modes[mi]);\n  }\n  var save = document.getElementById('tb-save');\n  if (save) {\n    save.addEventListener('click', function () {\n      var items = tbState.gallery ? tbState.gallery.split('|') : [];\n      if (items.length >= 12) {\n        tbSetMsg('Gallery is full (12). Delete one first.');\n        return;\n      }\n      items.push(tbState.data);\n      tbSetMsg('Saved to gallery (' + items.length + ' of 12).');\n      tbSave({ data: tbState.data, gallery: items.join('|') });\n    });\n  }\n  var clr = document.getElementById('tb-clear');\n  if (clr) {\n    clr.addEventListener('click', function () {\n      tbSetMsg('Canvas cleared.');\n      tbSave({ data: tbEmptyData(), gallery: tbState.gallery });\n    });\n  }\n  tbRender();\n}\nif (document.readyState === 'loading') {\n  document.addEventListener('DOMContentLoaded', tbInit);\n} else {\n  tbInit();\n}\n</script>\n</body>\n</html>\n"
    }
  },
  "ui": {
