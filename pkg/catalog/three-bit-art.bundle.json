    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<style>\n.tb-wrap { font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; color: #111; background: #fff; padding: 16px; max-width: 520px; margin: 0 auto; }\n.tb-grid { display: block; margin: 0 auto 12px auto; border: 2px solid #111; background: #888; cursor: pointer; touch-action: none; image-rendering: pixelated; }\n.tb-grid:focus { outline: 3px solid #111; outline-offset: 2px; }\n.tb-row { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }\n.tb-btn { flex: 1; font-family: inherit; font-size: 16px; min-height: 48px; border: 2px solid #111; background: #fff; color: #111; cursor: pointer; padding: 8px; }\n.tb-btn.on { outline: 4px solid #111; outline-offset: -4px; }\n.tb-pal { width: 48px; height: 48px; border: 2px solid #111; cursor: pointer; padding: 0; background-size: 100% 100%; background-repeat: no-repeat; }\n.tb-pal.on { outline: 4px solid #111; outline-offset: -4px; }\n.tb-msg { min-height: 24px; font-weight: 600; margin: 0 0 8px 0; }\n.tb-gal { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }\n.tb-item { border: 2px solid #111; padding: 6px; text-align: center; }\n.tb-thumb { display: block; width: 128px; height: 128px; margin-bottom: 6px; }\n.tb-note { font-size: 13px; color: #444; }\n</style>\n</head>\n<body>\n<div class=\"tb-wrap\">\n<p class=\"tb-msg\" id=\"tb-msg\">Tap the canvas to paint. Eight 1-bit pattern blocks, 16 by 16 pixels.</p>\n<canvas class=\"tb-grid\" id=\"tb-grid\" width=\"512\" height=\"512\" tabindex=\"0\" aria-label=\"3-bit art canvas\">This browser cannot draw the canvas.</canvas>\n<p class=\"tb-note\" id=\"tb-fail\" style=\"display:none\">This browser cannot draw the canvas (canvas 2D is unavailable).</p>\n<p class=\"tb-note\" id=\"tb-help\">Keyboard: focus the canvas, arrow keys move the cursor, Space paints.</p>\n<div class=\"tb-row\" id=\"tb-palette\"></div>\n<div class=\"tb-row\">\n<button type=\"button\" class=\"tb-btn tb-mode on\" data-mode=\"pattern\">Pattern</button>\n<button type=\"button\" class=\"tb-btn tb-mode\" data-mode=\"color\">Color</button>\n</div>\n<div class=\"tb-row\">\n<button type=\"button\" class=\"tb-btn\" id=\"tb-save\">Save to gallery</button>\n<button type=\"button\" class=\"tb-btn\" id=\"tb-clear\">Clear</button>\n</div>\n<div class=\"tb-gal\" id=\"tb-gallery\"></div>\n<p class=\"tb-note\">A kody-os rewrite of <a href=\"https://github.com/Hypercubed/3-bit-art\" target=\"_blank\" rel=\"noopener\">Hypercubed/3-bit-art</a> on GitHub.</p>\n</div>\n<script>\nvar tbScript = null;\ntry { tbScript = document.currentScript; } catch (err) { tbScript = null; }\nvar tbSection = null;\n(function () {\n  var el = tbScript;\n  while (el) {\n    if (el.getAttribute && el.getAttribute('data-app-id')) { tbSection = el; break; }\n    el = el.parentNode;\n  }\n  if (!tbSection) {\n    var secs = document.querySelectorAll('section[data-app-id]');\n    if (secs.length > 0) { tbSection = secs[0]; }\n  }\n})();\n// The 3-bit pattern map: eight 32x32 blocks, one per value, scaled as a whole\n// to the art pixel. Each block repeats an 8x8 tile 4x4, so the feature\n// count is the spec count: green gets 8 horizontal lines, cyan 8 vertical\n// lines, yellow and blue get 64 dots. Stretching one 8x8 tile to the block\n// would divide every feature count by 4 in each dimension. Pure black and\n// white, no grey. Density gives the light/dark band; motif separates the\n// close luma pairs: black solid vs blue sparse white dots, red down-right vs\n// magenta down-left diagonals, green horizontal vs cyan vertical lines,\n// yellow sparse dots vs white solid. Every tile is period 4 except the two\n// solids, so the 4x4 repeat is seamless.\n// The board is one canvas: each value's block is rendered once into an\n// offscreen canvas at the exact cell size, so DOM size does not grow with\n// tile resolution and no external fetch is needed. Rasterizing samples the\n// 32x32 matrix as nearest neighbour, one device pixel at a time: mapping each\n// source row with rounded edges instead lets a 1-pixel band collapse to zero\n// height, which drops green from 8 lines to 6 at a 30-pixel cell and 4 at 28.\n// Nearest sampling keeps every line, column, and dot from 28 device pixels up,\n// which covers the cell sizes the board actually uses (30 at ratio 1, 60 at\n// ratio 2). A cell of 27 or less is smaller than the 32-pixel block, so there\n// some rows have to be sampled away. Palette swatches show the\n// same 32x32 block as an SVG data URI; gallery thumbnails are small canvases.\nvar TB_TILE = 32;\nvar TB_LUM = [0, 54, 182, 237, 18, 73, 201, 255];\nvar TB_PATTERN_ROWS = [\n  [\"11111111\", \"11111111\", \"11111111\", \"11111111\", \"11111111\", \"11111111\", \"11111111\", \"11111111\"],\n  [\"11101110\", \"01110111\", \"10111011\", \"11011101\", \"11101110\", \"01110111\", \"10111011\", \"11011101\"],\n  [\"11111111\", \"00000000\", \"00000000\", \"00000000\", \"11111111\", \"00000000\", \"00000000\", \"00000000\"],\n  [\"10001000\", \"00000000\", \"00000000\", \"00000000\", \"10001000\", \"00000000\", \"00000000\", \"00000000\"],\n  [\"01110111\", \"11111111\", \"11111111\", \"11111111\", \"01110111\", \"11111111\", \"11111111\", \"11111111\"],\n  [\"11101110\", \"11011101\", \"10111011\", \"01110111\", \"11101110\", \"11011101\", \"10111011\", \"01110111\"],\n  [\"10001000\", \"10001000\", \"10001000\", \"10001000\", \"10001000\", \"10001000\", \"10001000\", \"10001000\"],\n  [\"00000000\", \"00000000\", \"00000000\", \"00000000\", \"00000000\", \"00000000\", \"00000000\", \"00000000\"]\n];\nfunction tbPattern(v) {\n  var rows = TB_PATTERN_ROWS[v], m = [], r, c;\n  for (r = 0; r < 32; r++) {\n    m[r] = [];\n    for (c = 0; c < 32; c++) {\n      m[r][c] = rows[r % 8].charAt(c % 8) === '1' ? 1 : 0;\n    }\n  }\n  return m;\n}\nvar TB_PATTERNS = (function () {\n  var out = [], v;\n  for (v = 0; v < 8; v++) { out.push(tbPattern(v)); }\n  return out;\n})();\nfunction tbTileUri(value) {\n  var rows = TB_PATTERN_ROWS[value];\n  var svg = \"<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 32 32'>\";\n  if (value === 0) {\n    svg += \"<rect width='32' height='32' fill='black'/>\";\n  } else {\n    svg += \"<rect width='32' height='32' fill='white'/>\";\n    svg += \"<pattern id='p' width='8' height='8' patternUnits='userSpaceOnUse'>\";\n    var r, c;\n    for (r = 0; r < 8; r++) {\n      for (c = 0; c < 8; c++) {\n        if (rows[r].charAt(c) === '1') {\n          svg += \"<rect x='\" + c + \"' y='\" + r + \"' width='1' height='1' fill='black'/>\";\n        }\n      }\n    }\n    svg += \"</pattern>\";\n    svg += \"<rect width='32' height='32' fill='url(#p)'/>\";\n  }\n  svg += '</svg>';\n  return 'url(\"data:image/svg+xml,' + encodeURIComponent(svg) + '\")';\n}\nvar TB_TILES = (function () {\n  var out = [], v;\n  for (v = 0; v < 8; v++) { out.push(tbTileUri(v)); }\n  return out;\n})();\nfunction tbGrey(v) {\n  var g = TB_LUM[v] || 0;\n  return 'rgb(' + g + ',' + g + ',' + g + ')';\n}\nvar tbStore = null;\nvar tbState = { data: '', gallery: '', mode: 'pattern' };\n// Color mode uses the standard 3-bit RGB cube, same bit order as the luma\n// mapping (R = bit 0, G = bit 1, B = bit 2). Mode is saved in state, so a\n// color display stays in color and the Scribe stays in pattern, with no\n// device detection: colorDepth reports 24-bit and the monochrome media\n// query is false on the Scribe, so neither can tell the two apart.\nvar TB_COLORS = ['#000000', '#ff0000', '#00ff00', '#ffff00', '#0000ff', '#ff00ff', '#00ffff', '#ffffff'];\nvar tbColor = 1;\nvar tbDragging = false;\nvar tbLastGallery = '';\nvar tbLastMode = '';\nvar tbCanvas = null;\nvar tbCtx = null;\nvar tbCellCss = 32;\nvar tbCellDev = 32;\nvar tbGapDev = 1;\nvar tbDpr = 1;\nvar tbCursor = 8 * 16 + 8;\nvar tbFocused = false;\nvar tbLastPaintIdx = -1;\nvar tbLastPaintAt = 0;\nvar tbLastDrawnData = '';\nvar tbLastDrawnMode = '';\nvar tbTileCanvases = [];\nfunction tbEmptyData() {\n  var s = '', i;\n  for (i = 0; i < 256; i++) { s += '7'; }\n  return s;\n}\nfunction tbLayout() {\n  var canvas = document.getElementById('tb-grid');\n  if (!canvas) { return false; }\n  var wrap = canvas.parentNode;\n  var avail = wrap && wrap.clientWidth ? wrap.clientWidth : 552;\n  var style = wrap && window.getComputedStyle ? window.getComputedStyle(wrap) : null;\n  var padL = style ? (parseInt(style.paddingLeft, 10) || 0) : 16;\n  var padR = style ? (parseInt(style.paddingRight, 10) || 0) : 16;\n  avail = avail - padL - padR;\n  if (avail < 16 * 8) { avail = 520; }\n  var cell = Math.floor(avail / 16);\n  if (cell < 8) { cell = 8; }\n  if (cell > 48) { cell = 48; }\n  var dpr = window.devicePixelRatio || 1;\n  if (dpr < 1) { dpr = 1; }\n  if (dpr > 2) { dpr = 2; }\n  var cellDev = Math.max(1, Math.round(cell * dpr));\n  tbCellCss = cell;\n  tbCellDev = cellDev;\n  tbDpr = dpr;\n  tbGapDev = Math.max(1, Math.round(dpr));\n  if (tbGapDev * 2 >= cellDev) { tbGapDev = 0; }\n  var devW = cellDev * 16;\n  var devH = cellDev * 16;\n  if (canvas.width !== devW || canvas.height !== devH) {\n    canvas.width = devW;\n    canvas.height = devH;\n  }\n  canvas.style.width = (cell * 16) + 'px';\n  canvas.style.height = (cell * 16) + 'px';\n  if ('imageSmoothingEnabled' in tbCtx) { tbCtx.imageSmoothingEnabled = false; }\n  if ('webkitImageSmoothingEnabled' in tbCtx) { tbCtx.webkitImageSmoothingEnabled = false; }\n  tbBuildTiles();\n  return true;\n}\nfunction tbBuildTiles() {\n  var size = tbCellDev - tbGapDev * 2;\n  if (size < 2) { size = 2; }\n  var v, x, y, sx, sy, run, start;\n  tbTileCanvases = [];\n  for (v = 0; v < 8; v++) {\n    var tile = document.createElement('canvas');\n    tile.width = size;\n    tile.height = size;\n    var g = null;\n    try { g = tile.getContext('2d'); } catch (err) { g = null; }\n    if (!g) { tbTileCanvases[v] = null; continue; }\n    g.fillStyle = '#fff';\n    g.fillRect(0, 0, size, size);\n    g.fillStyle = '#111';\n    for (y = 0; y < size; y++) {\n      sy = Math.floor(y * 32 / size);\n      start = -1;\n      for (x = 0; x <= size; x++) {\n        run = x < size && TB_PATTERNS[v][sy][Math.floor(x * 32 / size)] === 1;\n        if (run && start < 0) { start = x; }\n        else if (!run && start >= 0) { g.fillRect(start, y, x - start, 1); start = -1; }\n      }\n    }\n    tbTileCanvases[v] = tile;\n  }\n}\nfunction tbDrawCell(idx) {\n  if (!tbCtx) { return; }\n  var x = idx % 16;\n  var y = Math.floor(idx / 16);\n  var v = parseInt(tbState.data.charAt(idx), 10) || 0;\n  if (v < 0 || v > 7) { v = 0; }\n  var gx = x * tbCellDev + tbGapDev;\n  var gy = y * tbCellDev + tbGapDev;\n  var size = tbCellDev - tbGapDev * 2;\n  if (size < 1) { size = 1; }\n  if (tbState.mode === 'color') {\n    tbCtx.fillStyle = TB_COLORS[v] || '#ffffff';\n    tbCtx.fillRect(gx, gy, size, size);\n    return;\n  }\n  tbCtx.fillStyle = tbGrey(v);\n  tbCtx.fillRect(gx, gy, size, size);\n  var tile = tbTileCanvases[v];\n  if (tile) {\n    try { tbCtx.drawImage(tile, gx, gy); } catch (err) { /* grey fallback */ }\n  }\n}\nfunction tbDrawAll() {\n  if (!tbCtx) { return; }\n  tbCtx.fillStyle = '#888';\n  tbCtx.fillRect(0, 0, tbCanvas.width, tbCanvas.height);\n  for (var i = 0; i < 256; i++) { tbDrawCell(i); }\n  if (tbFocused) {\n    var cx = (tbCursor % 16) * tbCellDev;\n    var cy = Math.floor(tbCursor / 16) * tbCellDev;\n    var t = Math.max(2, Math.round(tbDpr * 2));\n    tbCtx.fillStyle = '#888';\n    tbCtx.fillRect(cx, cy, tbCellDev, t);\n    tbCtx.fillRect(cx, cy + tbCellDev - t, tbCellDev, t);\n    tbCtx.fillRect(cx, cy, t, tbCellDev);\n    tbCtx.fillRect(cx + tbCellDev - t, cy, t, tbCellDev);\n  }\n}\nfunction tbCellAt(e) {\n  if (!tbCanvas) { return -1; }\n  var rect = tbCanvas.getBoundingClientRect();\n  var borderL = tbCanvas.clientLeft || 0;\n  var borderT = tbCanvas.clientTop || 0;\n  var width = tbCanvas.clientWidth || rect.width || (tbCellCss * 16);\n  var height = tbCanvas.clientHeight || rect.height || (tbCellCss * 16);\n  var x = Math.floor((e.clientX - rect.left - borderL) / (width / 16));\n  var y = Math.floor((e.clientY - rect.top - borderT) / (height / 16));\n  if (x < 0 || x >= 16 || y < 0 || y >= 16) { return -1; }\n  return y * 16 + x;\n}\nfunction tbPaintAt(e) {\n  var idx = tbCellAt(e);\n  if (idx < 0) { return; }\n  tbCursor = idx;\n  tbPaint(idx);\n  if (tbFocused) { tbDrawAll(); }\n}\nfunction tbTouchPoint(e) {\n  if (e.touches && e.touches.length > 0) { return e.touches[0]; }\n  if (e.changedTouches && e.changedTouches.length > 0) { return e.changedTouches[0]; }\n  return null;\n}\nfunction tbKeyName(e) {\n  if (e.key) { return e.key; }\n  var c = e.keyCode;\n  if (c === 37) { return 'ArrowLeft'; }\n  if (c === 38) { return 'ArrowUp'; }\n  if (c === 39) { return 'ArrowRight'; }\n  if (c === 40) { return 'ArrowDown'; }\n  if (c === 32) { return ' '; }\n  if (c === 13) { return 'Enter'; }\n  return '';\n}\nfunction tbWireBoard() {\n  var c = tbCanvas;\n  if (!c) { return; }\n  c.addEventListener('mousedown', function (e) {\n    if (e.button && e.button !== 0) { return; }\n    tbDragging = true;\n    tbLastPaintIdx = -1;\n    tbPaintAt(e);\n    e.preventDefault();\n  });\n  c.addEventListener('mousemove', function (e) {\n    if (!tbDragging) { return; }\n    if (e.buttons !== undefined && (e.buttons & 1) !== 1) { return; }\n    tbPaintAt(e);\n  });\n  c.addEventListener('mouseleave', function () { tbDragging = false; });\n  document.addEventListener('mouseup', function () { tbDragging = false; });\n  c.addEventListener('touchstart', function (e) {\n    var t = tbTouchPoint(e);\n    if (!t) { return; }\n    tbDragging = true;\n    tbLastPaintIdx = -1;\n    tbPaintAt(t);\n    e.preventDefault();\n  }, false);\n  c.addEventListener('touchmove', function (e) {\n    if (!tbDragging) { return; }\n    var t = tbTouchPoint(e);\n    if (!t) { return; }\n    tbPaintAt(t);\n    e.preventDefault();\n  }, false);\n  c.addEventListener('touchend', function () { tbDragging = false; }, false);\n  c.addEventListener('touchcancel', function () { tbDragging = false; }, false);\n  c.addEventListener('focus', function () { tbFocused = true; tbDrawAll(); });\n  c.addEventListener('blur', function () { tbFocused = false; tbDrawAll(); });\n  c.addEventListener('keydown', function (e) {\n    var key = tbKeyName(e);\n    var x = tbCursor % 16;\n    var y = Math.floor(tbCursor / 16);\n    if (key === ' ' || key === 'Spacebar' || key === 'Enter') {\n      tbPaint(tbCursor);\n      if (tbFocused) { tbDrawAll(); }\n      e.preventDefault();\n      return;\n    }\n    if (key === 'ArrowLeft' || key === 'Left') { x -= 1; }\n    else if (key === 'ArrowRight' || key === 'Right') { x += 1; }\n    else if (key === 'ArrowUp' || key === 'Up') { y -= 1; }\n    else if (key === 'ArrowDown' || key === 'Down') { y += 1; }\n    else { return; }\n    e.preventDefault();\n    if (x < 0) { x = 0; }\n    if (x >= 16) { x = 15; }\n    if (y < 0) { y = 0; }\n    if (y >= 16) { y = 15; }\n    tbCursor = y * 16 + x;\n    tbDrawAll();\n  });\n}\nfunction tbRebase(server, pending, sent) { return { args: pending, optimistic: pending }; }\nfunction tbSave(next) {\n  tbState = { data: next.data, gallery: next.gallery, mode: next.mode || tbState.mode || 'pattern' };\n  tbRender();\n  if (tbStore) { tbStore.dispatch('save', tbState, tbState, tbRebase); }\n}\nfunction tbSetMsg(text) {\n  var el = document.getElementById('tb-msg');\n  if (el) { el.textContent = text; }\n}\nfunction tbPaint(idx) {\n  var now = Date.now ? Date.now() : new Date().getTime();\n  if (idx === tbLastPaintIdx && now - tbLastPaintAt < 120) { return; }\n  tbLastPaintIdx = idx;\n  tbLastPaintAt = now;\n  var cells = tbState.data.split('');\n  cells[idx] = String(tbColor);\n  var next = cells.join('');\n  if (next === tbState.data) { return; }\n  tbState.data = next;\n  tbLastDrawnData = next;\n  if (tbCanvas && tbCtx) { tbDrawCell(idx); }\n  if (tbStore) { tbStore.dispatch('save', tbState, tbState, tbRebase); }\n}\nfunction tbRenderGrid() {\n  if (!tbCtx) { return; }\n  if (tbState.data === tbLastDrawnData && tbState.mode === tbLastDrawnMode) { return; }\n  tbDrawAll();\n  tbLastDrawnData = tbState.data;\n  tbLastDrawnMode = tbState.mode;\n}\nfunction tbRenderGallery() {\n  var gal = document.getElementById('tb-gallery');\n  if (!gal) { return; }\n  while (gal.firstChild) { gal.removeChild(gal.firstChild); }\n  if (!tbState.gallery) { return; }\n  var items = tbState.gallery.split('|');\n  for (var k = 0; k < items.length; k++) {\n    (function (idx, drawing) {\n      var item = document.createElement('div');\n      item.className = 'tb-item';\n      var thumb = document.createElement('canvas');\n      thumb.className = 'tb-thumb';\n      var dpr = Math.round(tbDpr);\n      if (dpr < 1) { dpr = 1; }\n      if (dpr > 2) { dpr = 2; }\n      thumb.width = 128 * dpr;\n      thumb.height = 128 * dpr;\n      thumb.style.width = '128px';\n      thumb.style.height = '128px';\n      var g = null;\n      try { g = thumb.getContext('2d'); } catch (err) { g = null; }\n      if (g) {\n        var px = thumb.width / 16;\n        var p, v;\n        for (p = 0; p < 256 && p < drawing.length; p++) {\n          v = parseInt(drawing.charAt(p), 10) || 0;\n          if (v < 0 || v > 7) { v = 0; }\n          if (tbState.mode === 'color') { g.fillStyle = TB_COLORS[v] || '#ffffff'; }\n          else { g.fillStyle = tbGrey(v); }\n          g.fillRect((p % 16) * px, Math.floor(p / 16) * px, px, px);\n        }\n      }\n      var load = document.createElement('button');\n      load.type = 'button';\n      load.className = 'tb-btn';\n      load.textContent = 'Load';\n      load.addEventListener('click', function () {\n        tbSetMsg('Loaded drawing ' + (idx + 1) + ' from the gallery.');\n        tbSave({ data: drawing, gallery: tbState.gallery });\n      });\n      var del = document.createElement('button');\n      del.type = 'button';\n      del.className = 'tb-btn';\n      del.textContent = 'Delete';\n      del.addEventListener('click', function () {\n        var rest = tbState.gallery.split('|');\n        rest.splice(idx, 1);\n        tbSetMsg('Deleted drawing ' + (idx + 1) + '.');\n        tbSave({ data: tbState.data, gallery: rest.join('|') });\n      });\n      item.appendChild(thumb);\n      item.appendChild(load);\n      item.appendChild(del);\n      gal.appendChild(item);\n    })(k, items[k]);\n  }\n}\nfunction tbRender() {\n  if (tbState.data && tbState.data.length === 256) {\n    tbRenderGrid();\n  }\n  if (tbState.gallery !== tbLastGallery || tbState.mode !== tbLastMode) {\n    tbLastGallery = tbState.gallery;\n    tbLastMode = tbState.mode;\n    tbRenderGallery();\n  }\n  var pals = document.querySelectorAll('.tb-pal');\n  for (var i = 0; i < pals.length; i++) {\n    var pv = parseInt(pals[i].getAttribute('data-color'), 10) || 0;\n    if (pv === tbColor) { pals[i].className = 'tb-pal on'; }\n    else { pals[i].className = 'tb-pal'; }\n    if (tbState.mode === 'color') {\n      pals[i].style.backgroundColor = TB_COLORS[pv] || '#ffffff';\n      pals[i].style.backgroundImage = '';\n    } else {\n      pals[i].style.backgroundColor = tbGrey(pv);\n      pals[i].style.backgroundImage = TB_TILES[pv] || '';\n    }\n  }\n  var modes = document.querySelectorAll('.tb-mode');\n  for (var m = 0; m < modes.length; m++) {\n    if (modes[m].getAttribute('data-mode') === tbState.mode) { modes[m].className = 'tb-btn tb-mode on'; }\n    else { modes[m].className = 'tb-btn tb-mode'; }\n  }\n}\nfunction tbInit() {\n  if (window.KodyBridge && tbSection) {\n    tbStore = window.KodyBridge.create(tbSection, {\n      fieldTypes: { data: 'string', gallery: 'string' },\n      reassert: function (desired) { return { action: 'save', args: desired, optimistic: desired, rebase: tbRebase }; }\n    });\n    tbStore.subscribe(function (snap) {\n      var d = snap.desired;\n      if (d && typeof d.data === 'string' && d.data.length === 256) {\n        tbState = { data: d.data, gallery: d.gallery || '', mode: d.mode || 'pattern' };\n        tbRender();\n      }\n    });\n    tbStore.startSpanObserver();\n    var cur = tbStore.getState().desired;\n    if (cur && typeof cur.data === 'string' && cur.data.length === 256) {\n      tbState = { data: cur.data, gallery: cur.gallery || '', mode: cur.mode || 'pattern' };\n    }\n  } else {\n    var seed = null;\n    var scripts = document.querySelectorAll('script[data-kody-state-seed]');\n    for (var s = 0; s < scripts.length; s++) {\n      try { seed = JSON.parse(scripts[s].textContent); } catch (err) { seed = null; }\n      if (seed) { break; }\n    }\n    if (seed && typeof seed.data === 'string' && seed.data.length === 256) {\n      tbState = { data: seed.data, gallery: seed.gallery || '', mode: seed.mode || 'pattern' };\n    } else {\n      tbState = { data: tbEmptyData(), gallery: '', mode: 'pattern' };\n    }\n  }\n  if (!tbState.data || tbState.data.length !== 256) { tbState.data = tbEmptyData(); }\n  if (!tbState.mode) { tbState.mode = 'pattern'; }\n  var canvas = document.getElementById('tb-grid');\n  if (canvas && canvas.getContext) {\n    try { tbCtx = canvas.getContext('2d'); } catch (err) { tbCtx = null; }\n  }\n  if (canvas && tbCtx) {\n    tbCanvas = canvas;\n    tbCursor = 8 * 16 + 8;\n    tbLayout();\n    tbWireBoard();\n  } else {\n    if (canvas) { canvas.style.display = 'none'; }\n    var fail = document.getElementById('tb-fail');\n    if (fail) { fail.style.display = ''; }\n  }\n  var pal = document.getElementById('tb-palette');\n  if (pal) {\n    for (var c = 0; c < TB_TILES.length; c++) {\n      (function (idx) {\n        var b = document.createElement('div');\n        b.className = idx === tbColor ? 'tb-pal on' : 'tb-pal';\n        b.setAttribute('role', 'button');\n        b.setAttribute('tabindex', '0');\n        b.setAttribute('data-color', String(idx));\n        b.setAttribute('aria-lab