{
  "id": "eight-ball",
  "name": "Eight Ball",
  "label": "Eight Ball",
  "schemaVersion": 5,
  "catalogVersion": 5,
  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><circle cx=\"12\" cy=\"12\" r=\"9\" /><circle cx=\"12\" cy=\"9.4\" r=\"2.4\" /><circle cx=\"12\" cy=\"15\" r=\"2.8\" /></svg>",
  "category": "toys",
  "description": "A Magic 8-Ball for yes-or-no questions.",
  "bundle": {
    "entry": "index.html",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<style>\n.ball-wrap { text-align: center; padding: 24px 16px; }\n.ball { width: 200px; height: 200px; margin: 0 auto 16px auto; border-radius: 50%; background: #111; color: #fff; display: flex; align-items: center; justify-content: center; }\n.window { width: 120px; height: 120px; border-radius: 50%; background: #fff; color: #111; display: flex; align-items: center; justify-content: center; padding: 12px; }\n.ball-answer { font-size: 15px; line-height: 1.3; margin: 0; }\n/* Eight Ball: vertically center body content in the app panel and Home widget (moved from the shell theme — app styles live in the app). */\n.widget[aria-label=\"Eight Ball\"] {\n\tdisplay: flex;\n\tflex-direction: column;\n}\n.widget[aria-label=\"Eight Ball\"] .app-body,\n.app[aria-label=\"Eight Ball\"] .app-body {\n\tflex: 1;\n\tdisplay: flex;\n\tflex-direction: column;\n\tjustify-content: center;\n\tmin-height: 8rem;\n}\n</style>\n</head>\n<body>\n<div class=\"ball-wrap\">\n<div class=\"ball\" aria-hidden=\"true\">\n<div class=\"window\"><p class=\"ball-answer\">Ask a question, then tap Shake.</p></div>\n</div>\n<button type=\"button\" class=\"ball-shake\">Shake</button>\n</div>\n<script>\nfunction shakeIn(root) {\n  var answers = [\n    'It is certain.',\n    'It is decidedly so.',\n    'Without a doubt.',\n    'Yes definitely.',\n    'You may rely on it.',\n    'As I see it, yes.',\n    'Most likely.',\n    'Outlook good.',\n    'Yes.',\n    'Signs point to yes.',\n    'Reply hazy, try again.',\n    'Ask again later.',\n    'Better not tell you now.',\n    'Cannot predict now.',\n    'Concentrate and ask again.',\n    'Do not count on it.',\n    'My reply is no.',\n    'My sources say no.',\n    'Outlook not so good.',\n    'Very doubtful.'\n  ];\n  var out = root.querySelector('.ball-answer');\n  if (!out) { return; }\n  var i = Math.floor(Math.random() * answers.length);\n  out.textContent = answers[i];\n}\nfunction initBall() {\n  var roots = document.querySelectorAll('.ball-wrap');\n  for (var i = 0; i < roots.length; i++) {\n    (function (root) {\n      var btn = root.querySelector('.ball-shake');\n      if (btn && btn.addEventListener) {\n        btn.addEventListener('click', function () { shakeIn(root); });\n      }\n    })(roots[i]);\n  }\n}\nif (document.readyState === 'loading') {\n  if (document.addEventListener) { document.addEventListener('DOMContentLoaded', initBall); }\n} else {\n  initBall();\n}\n</script>\n</body>\n</html>\n"
    }
  },
