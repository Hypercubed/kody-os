{
  "id": "calculator",
  "name": "Calculator",
  "label": "Calculator",
  "schemaVersion": 4,
  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><rect x=\"5.5\" y=\"3.5\" width=\"13\" height=\"17\" rx=\"1.5\" /><path d=\"M8.5 7.5h7\" /><path d=\"M8.5 12h1.5M11.2 12h1.5M14 12h1.5M8.5 15.5h1.5M11.2 15.5h1.5M14 15.5h1.5\" /></svg>",
  "category": "utilities",
  "description": "Original Macintosh Calculator: C clears all, E clears last entry, = , *, /, -, + (tall), digits, decimal, wide 0. Runs fully in the page, no saved state.",
  "bundle": {
    "entry": "index.html",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<style>\n.calc-wrap { font-family: \"Chicago\", \"Geneva\", Helvetica, Arial, sans-serif; color: #000; background-color: #fff; background-image: radial-gradient(#000 1px, transparent 1.4px); background-size: 4px 4px; text-align: center; padding: 16px; max-width: 320px; margin: 0 auto; }\n.calc-display { font-size: 28px; text-align: right; background: #fff; color: #000; border: 1px solid #000; padding: 8px 12px; margin: 0 0 16px 0; min-height: 48px; box-sizing: border-box; overflow: hidden; white-space: nowrap; }\n.calc-keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }\n.calc-key { min-height: 48px; font-size: 20px; font-weight: normal; background: #fff; color: #000; border: 1px solid #000; border-radius: 4px; box-shadow: 2px 2px 0 #000; padding: 0; }\n.calc-key.wide { grid-column: span 2; }\n.calc-key.tall { grid-row: span 2; }\n</style>\n</head>\n<body>\n<div class=\"calc-wrap\">\n<p class=\"calc-display\" id=\"calc-display\">0</p>\n<div class=\"calc-keys\" id=\"calc-keys\"></div>\n</div>\n<script>\n(function () {\n  var displayEl = document.getElementById('calc-display');\n  var keysEl = document.getElementById('calc-keys');\n  var entry = '0';\n  var accumulator = null;\n  var pending = null;\n  var waiting = false;\n  var error = false;\n\n  function formatResult(value) {\n    if (!isFinite(value)) { return 'Error'; }\n    var rounded = Math.round(value * 10000000000) / 10000000000;\n    var text = String(rounded);\n    if (text.length > 12) {\n      if (Math.abs(rounded) >= 1000000000000 || (Math.abs(rounded) < 0.000001 && rounded !== 0)) {\n        text = rounded.toExponential(5);\n      } else {\n        text = text.slice(0, 12);\n      }\n    }\n    return text;\n  }\n\n  function show() {\n    displayEl.textContent = entry;\n  }\n\n  function compute(a, op, b) {\n    if (op === '+') { return a + b; }\n    if (op === '-') { return a - b; }\n    if (op === '*') { return a * b; }\n    if (op === '/') { return b === 0 ? NaN : a / b; }\n    return b;\n  }\n\n  function clearAll() {\n    entry = '0';\n    accumulator = null;\n    pending = null;\n    waiting = false;\n    error = false;\n    show();\n  }\n\n  function clearEntry() {\n    if (error) { clearAll(); return; }\n    entry = '0';\n    waiting = false;\n    show();\n  }\n\n  function pressDigit(digit) {\n    if (error) { clearAll(); }\n    if (waiting) {\n      entry = digit;\n      waiting = false;\n    } else {\n      if (entry === '0') { entry = digit; }\n      else if (entry.replace(/[^0-9]/g, '').length < 12) { entry += digit; }\n    }\n    show();\n  }\n\n  function pressDecimal() {\n    if (error) { clearAll(); }\n    if (waiting) {\n      entry = '0.';\n      waiting = false;\n    } else if (entry.indexOf('.') < 0) {\n      entry += '.';\n    }\n    show();\n  }\n\n  function pressOperator(op) {\n    if (error) { return; }\n    var value = parseFloat(entry);\n    if (pending !== null && !waiting) {\n      var result = compute(accumulator, pending, value);\n      entry = formatResult(result);\n      if (entry === 'Error') { error = true; accumulator = null; pending = null; waiting = false; show(); return; }\n      accumulator = parseFloat(entry);\n    } else {\n      accumulator = value;\n    }\n    pending = op;\n    waiting = true;\n    show();\n  }\n\n  function pressEquals() {\n    if (error || pending === null) { return; }\n    var value = parseFloat(entry);\n    var result = compute(accumulator, pending, value);\n    entry = formatResult(result);\n    if (entry === 'Error') { error = true; }\n    accumulator = null;\n    pending = null;\n    waiting = true;\n    show();\n  }\n\n  function pressKey(key) {\n    if (key >= '0' && key <= '9') { pressDigit(key); }\n    else if (key === '.') { pressDecimal(); }\n    else if (key === '+') { pressOperator('+'); }\n    else if (key === '-') { pressOperator('-'); }\n    else if (key === '*') { pressOperator('*'); }\n    else if (key === '/') { pressOperator('/'); }\n    else if (key === '=') { pressEquals(); }\n    else if (key === 'C') { clearAll(); }\n    else if (key === 'E') { clearEntry(); }\n  }\n\n  var keys = [\n    { label: 'C', key: 'C' },\n    { label: 'E', key: 'E' },\n    { label: '=', key: '=' },\n    { label: '*', key: '*' },\n    { label: '7', key: '7' },\n    { label: '8', key: '8' },\n    { label: '9', key: '9' },\n    { label: '/', key: '/' },\n    { label: '4', key: '4' },\n    { label: '5', key: '5' },\n    { label: '6', key: '6' },\n    { label: '-', key: '-' },\n    { label: '1', key: '1' },\n    { label: '2', key: '2' },\n    { label: '3', key: '3' },\n    { label: '+', key: '+', tall: true },\n    { label: '0', key: '0', wide: true },\n    { label: '.', key: '.' }\n  ];\n\n  function init() {\n    for (var i = 0; i < keys.length; i++) {\n      (function (def) {\n        var btn = document.createElement('button');\n        btn.type = 'button';\n        btn.className = 'calc-key' + (def.wide ? ' wide' : '') + (def.tall ? ' tall' : '');\n        btn.textContent = def.label;\n        btn.addEventListener('click', function () { pressKey(def.key); });\n        keysEl.appendChild(btn);\n      })(keys[i]);\n    }\n    document.addEventListener('keydown', function (e) {\n      var k = e.key;\n      if ((k >= '0' && k <= '9') || k === '.' || k === '+' || k === '-' || k === '*' || k === '/') {\n        pressKey(k);\n      } else if (k === 'Enter' || k === '=') {\n        e.preventDefault();\n        pressEquals();\n      } else if (k === 'Escape') {\n        clearEntry();\n      } else if (k === 'c' || k === 'C') {\n        clearAll();\n      } else if (k === 'e' || k === 'E') {\n        clearEntry();\n      }\n    });\n    show();\n  }\n\n  if (document.readyState !== 'loading') {\n    init();\n  } else {\n    document.addEventListener('DOMContentLoaded', init);\n  }\n})();\n</script>\n</body>\n</html>\n"
    }
  },
