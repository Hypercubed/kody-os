{
  "id": "counter",
  "name": "Counter",
  "label": "Counter",
  "schemaVersion": 4,
  "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><rect x=\"3.5\" y=\"3.5\" width=\"17\" height=\"17\" rx=\"2\" /><path d=\"M12 8v8M8 12h8\" /></svg>",
  "category": "Tests",
  "description": "Unified validation app: a shared counter proving bundle UI and MCP act on the same state through set actions.",
  "bundle": {
    "entry": "index.html",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<style>\n.counter-wrap { font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif; color: #111; background: #fff; text-align: center; padding: 24px 16px; }\n.counter-num { font-size: 56px; line-height: 1.1; margin: 0 0 16px 0; font-variant-numeric: tabular-nums; }\n.counter-row { margin: 0; }\n.counter-step { font-family: inherit; font-size: 17px; min-width: 64px; min-height: 48px; padding: 10px 22px; margin: 0 6px; border: 2px solid #111; border-radius: 999px; background: #fff; color: #111; cursor: pointer; }\n.counter-hint { font-size: 13px; color: #444; margin: 12px 0 0 0; }\n</style>\n</head>\n<body>\n<!-- Reference implementation: bundle/shell interaction contract in pkg/docs/adding-an-app.md. Pattern: read initial state from the shell [data-field] span, paint display and span together, one in-flight write at a time with later inputs coalesced, capture-phase claim plus MutationObserver adoption with a sequencing guard for shell-form actions, action URLs from data-action-base. Verified by pkg/examples/tests/counter-tests.cjs. The script style here is stricter than the ceiling in docs/scribe-limitations.md; the ceiling itself allows more. -->\n<div class=\"counter-wrap\">\n<p class=\"counter-num\">0</p>\n<p class=\"counter-row\"><button type=\"button\" class=\"counter-step\" data-delta=\"1\">+1</button><button type=\"button\" class=\"counter-step\" data-delta=\"-1\">-1</button></p>\n\n</div>\n<script>\n/* Reference implementation for the bundle/shell interaction contract in docs/adding-an-app.md. See the contract and the harness in pkg/examples/tests/counter-tests.cjs before copying this pattern. */\nfunction fieldEl() {\n  var p = document.querySelector('[data-field=\"count\"]');\n  if (!p) { return null; }\n  var span = p.querySelector('span');\n  if (span) { return span; }\n  return p.querySelector('[data-value]');\n}\nfunction readFieldValue() {\n  var el = fieldEl();\n  if (!el) { return null; }\n  var t = el.textContent;\n  if (t !== null && t !== undefined) {\n    var n = parseInt(t, 10);\n    if (!isNaN(n)) { return n; }\n  }\n  if (el.getAttribute) {\n    var attr = el.getAttribute('data-value');\n    if (attr !== null) {\n      var m = parseInt(attr, 10);\n      if (!isNaN(m)) { return m; }\n    }\n  }\n  return null;\n}\nfunction readCount() {\n  /* The shell renders the live state as <p data-field=\"count\"><span>9</span></p>\n   * (a plain span, no data-value attribute). Read that first: the bundle's\n   * own .counter-num is hardcoded to 0 in the stored HTML, so reading it\n   * alone would restart the counter at 0 on every page load. */\n  var v = readFieldValue();\n  if (v !== null) { return v; }\n  var shown = document.querySelectorAll('.counter-wrap .counter-num');\n  for (var i = 0; i < shown.length; i++) {\n    var t = parseInt(shown[i].textContent, 10);\n    if (!isNaN(t)) { return t; }\n  }\n  return 0;\n}\nfunction paintCount(n) {\n  var nums = document.querySelectorAll('.counter-wrap .counter-num');\n  for (var i = 0; i < nums.length; i++) { nums[i].textContent = String(n); }\n  var el = fieldEl();\n  if (el) {\n    el.textContent = String(n);\n    if (el.getAttribute && el.getAttribute('data-value') !== null) { el.setAttribute('data-value', String(n)); }\n  }\n}\nfunction clampCount(n) {\n  if (n < 0) { return 0; }\n  if (n > 1000000) { return 1000000; }\n  return n;\n}\nfunction codeParam() {\n  var m = new RegExp('[?&]k=([^&]*)').exec(window.location.search || '');\n  return m ? m[1] : '';\n}\nfunction actionBase(el) {\n  var host = el;\n  while (host && host.getAttribute) {\n    var base = host.getAttribute('data-action-base');\n    if (base) { return base; }\n    host = host.parentNode;\n  }\n  return window.location.pathname;\n}\nfunction buildActionUrl(base, value) {\n  var url = base + '?action=set_count&value=' + String(value);\n  var k = codeParam();\n  if (k !== '') { url += '&k=' + k; }\n  return url;\n}\n/* Single source of truth after init: clicks update desiredCount and\n * paint it immediately, instead of re-reading the painted DOM (which\n * only changes when a fetch returns). flushCounter sends at most one\n * request at a time; clicks made while one is in flight are coalesced\n * into a single follow-up request for the latest desired value, so\n * rapid clicks never send duplicate set_count calls with the same\n * value. No increment action is needed: set_count is still the only\n * action, with the same 0..1000000 clamp.\n *\n * The shell's Reset button is not in this bundle: it is the ui.actions\n * form the shell renders below the bundle. In a capable browser the\n * shell's client replays that form with ?format=json and patches only\n * the [data-field] span in place, never touching this bundle's display\n * or its desired/confirmed counts. Two problems followed from that.\n * First, Reset had no optimistic paint: +1/-1 paint immediately, but\n * Reset only moved when the shell's fetch returned (a full round trip\n * through the shell entrypoint), so it felt slow and out of sync with\n * the step buttons. Second, the shell's span patch is an unsequenced\n * signal: if a step was taken after Reset was pressed but before the\n * Reset fetch returned, the late patch (0) overwrote the step, and the\n * in-flight handler then re-sent 0 server-side, losing the step. The\n * reverse happened too: a stale pre-Reset set_count response could\n * repaint the old value after Reset was pressed. watchField() below\n * observes the shell field and adopts any value the bundle did not\n * itself paint, so a shell Reset (or any other shell-form action on\n * this field) resets the bundle as well, but a patch that arrives\n * after a step taken since the Reset was pressed is now recognised\n * as stale and ignored. On top of that, the bundle takes ownership\n * of the Reset submit in capable browsers (see handleResetSubmit):\n * a capture-phase submit listener paints 0 immediately and sends\n * set_count=0 through the same single-flight flushCounter queue as\n * the step buttons, so Reset is ordered with steps instead of racing\n * them. If capture interception does not run (an engine that does\n * not deliver submit capture, or a missing document listener), the\n * form-level listener still paints 0 at submit time and the\n * sequencing guard above keeps the later shell patch from losing\n * steps. The no-JS path needs neither: it reloads the page and init\n * reads the freshly rendered field value. */\nvar confirmedCount = 0;\nvar desiredCount = 0;\nvar inFlight = false;\nvar inFlightValue = 0;\nvar flushBase = '';\n/* Sequencing for Reset vs steps. opSeq counts local actions (steps and\n * Reset submits). A Reset submit records resetOpSeq; a shell span patch\n * that arrives after opSeq has moved past it is stale and must not\n * adopt. handledSubmit stops the same submit event being handled once\n * in the capture phase and again in the bubble phase. */\nvar opSeq = 0;\nvar resetPending = false;\nvar resetOpSeq = -1;\nvar handledSubmit = null;\n/* The shell renders the bundle inside <div class=\"bundle\"\n * data-action-base=\".../apps/<id>\">, inside <section data-app-id>.\n * Capture the owning section (or, failing that, the bundle div's\n * parent) while document.currentScript is still this script, so the\n * Reset submit handler only claims this app's own form when several\n * apps share a page. Falls back to the whole document when the\n * script is evaluated rather than parsed in place (tests). */\nvar bundleScope = null;\nvar bundleActionBase = '';\ntry {\n  var bundleScriptEl = document.currentScript;\n  if (bundleScriptEl) {\n    var scopeWalk = bundleScriptEl.parentNode;\n    var baseNode = null;\n    while (scopeWalk) {\n      if (scopeWalk.getAttribute) {\n        if (scopeWalk.getAttribute('data-app-id')) { bundleScope = scopeWalk; break; }\n        if (!baseNode && scopeWalk.getAttribute('data-action-base')) { baseNode = scopeWalk; }\n      }\n      scopeWalk = scopeWalk.parentNode;\n    }\n    if (baseNode) {\n      bundleActionBase = baseNode.getAttribute('data-action-base') || '';\n      if (!bundleScope && baseNode.parentNode) { bundleScope = baseNode.parentNode; }\n    }\n  }\n} catch (scopeErr) { bundleScope = null; bundleActionBase = ''; }\nfunction inBundleScope(el) {\n  if (!bundleScope) { return true; }\n  var n = el;\n  while (n) { if (n === bundleScope) { return true; } n = n.parentNode; }\n  return false;\n}\nfunction flushCounter() {\n  if (inFlight) { return; }\n  if (desiredCount === confirmedCount) { return; }\n  var value = desiredCount;\n  var base = flushBase;\n  var url = buildActionUrl(base, value);\n  if (!window.fetch) {\n    window.location.href = url;\n    return;\n  }\n  inFlight = true;\n  inFlightValue = value;\n  window.fetch(url + '&format=json', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } }).then(\n    function (r) { return r.json(); }\n  ).then(\n    function (res) {\n      inFlight = false;\n      if (res && res.ok && res.state && typeof res.state.count === 'number') {\n        var server = clampCount(res.state.count);\n        if (server !== inFlightValue) {\n          /* Someone else moved the count while this request was in\n           * flight: keep the pending deltas, rebased onto the\n           * server's value, instead of overwriting them. */\n          desiredCount = clampCount(server + (desiredCount - inFlightValue));\n        }\n        confirmedCount = server;\n        if (resetPending && server === desiredCount && opSeq === resetOpSeq) { resetPending = false; }\n        paintCount(desiredCount);\n        flushCounter();\n        return;\n      }\n      /* One navigation for the whole burst, for the latest desired\n       * value, not one per click. */\n      window.location.href = buildActionUrl(base, desiredCount);\n    },\n    function () {\n      inFlight = false;\n      window.location.href = buildActionUrl(base, desiredCount);\n    }\n  );\n}\nfunction stepCounter(delta, base) {\n  opSeq = opSeq + 1;\n  flushBase = base;\n  desiredCount = clampCount(desiredCount + delta);\n  paintCount(desiredCount);\n  flushCounter();\n}\nfunction resetBase(form) {\n  var a = form.getAttribute ? form.getAttribute('action') : '';\n  if (a) {\n    var q = a.indexOf('?');\n    return q === -1 ? a : a.slice(0, q);\n  }\n  return actionBase(form);\n}\nfunction isResetForm(form) {\n  if (!form || !form.getAttribute || form.tagName !== 'FORM') { return false; }\n  if (!inBundleScope(form)) { return false; }\n  var inputs = form.querySelectorAll ? form.querySelectorAll('input[name=\"action\"]') : [];\n  var ok = false;\n  for (var i = 0; i < inputs.length; i++) {\n    if (inputs[i].value === 'reset_count') { ok = true; }\n  }\n  if (!ok) { return false; }\n  if (bundleActionBase && resetBase(form) !== bundleActionBase) { return false; }\n  return true;\n}\n/* Reset submit, in two phases. The capture-phase listener on the\n * document runs before the shell client's form listener, so when it\n * claims the submit (ownIt) the shell fetch never starts: Reset goes\n * through the same single-flight queue as +1/-1, paints 0 at once,\n * and cannot be overtaken by a stale shell patch. If capture does\n * not deliver (the form-level listener below runs instead), the\n * submit is only painted and sequenced here and the shell client's\n * fetch still does the server call; the stale-patch guard in\n * syncFromField then keeps its late patch from losing steps. */\nfunction handleResetSubmit(event, form, ownIt) {\n  if (handledSubmit === event) { return; }\n  handledSubmit = event;\n  opSeq = opSeq + 1;\n  resetPending = true;\n  resetOpSeq = opSeq;\n  desiredCount = 0;\n  flushBase = resetBase(form);\n  paintCount(0);\n  if (ownIt) {\n    try { if (event.preventDefault) { event.preventDefault(); } } catch (preventErr) {}\n    try { if (event.stopPropagation) { event.stopPropagation(); } } catch (stopErr) {}\n    flushCounter();\n  }\n}\nfunction onSubmitCapture(event) {\n  var form = event && event.target ? event.target : null;\n  if (!form || form.tagName !== 'FORM') { return; }\n  if (!isResetForm(form)) { return; }\n  handleResetSubmit(event, form, true);\n}\nfunction attachResetForms() {\n  var forms = document.querySelectorAll('form.app-action');\n  for (var i = 0; i < forms.length; i++) {\n    (function (form) {\n      if (!isResetForm(form)) { return; }\n      if (form.addEventListener) {\n        form.addEventListener('submit', function (event) { handleResetSubmit(event, form, false); });\n      }\n    })(forms[i]);\n  }\n}\nfunction syncFromField() {\n  var v = readFieldValue();\n  if (v === null) { return; }\n  v = clampCount(v);\n  if (v === desiredCount) { return; }\n  if (resetPending && opSeq > resetOpSeq) {\n    /* The shell changed the field without going through this bundle\n     * (the Reset form's in-place patch), but a step was taken after\n     * the Reset was pressed, so this patch predates the user's\n     * latest intent. Ignore it and paint the desired value back:\n     * adopting it would drop the step, and the in-flight handler\n     * would then re-send the adopted value server-side, losing\n     * the step for good. */\n    resetPending = false;\n    paintCount(desiredCount);\n    return;\n  }\n  /* The shell changed the field without going through this bundle\n   * (the Reset form's in-place patch). Adopt the server value and\n   * drop any pending deltas: the user's last action was the reset.\n   * paintCount writes the same value back to the field, so the\n   * observer sees no further change and does not loop. A set_count\n   * still in flight may return a stale pre-Reset value afterwards;\n   * its handler paints this adopted value and flushCounter then\n   * re-sends it, so the reset wins instead of being overwritten. */\n  resetPending = false;\n  desiredCount = v;\n  confirmedCount = v;\n  paintCount(v);\n}\nfunction watchField() {\n  var p = document.querySelector('[data-field=\"count\"]');\n  if (!p) { return; }\n  if (typeof MutationObserver === 'undefined' || !MutationObserver) { return; }\n  var obs = new MutationObserver(function () { syncFromField(); });\n  obs.observe(p, { childList: true, characterData: true, subtree: true, attributes: true, attributeFilter: ['data-value'] });\n}\nvar counterInitialized = false;\nfunction initCounter() {\n  if (counterInitialized) { return; }\n  counterInitialized = true;\n  confirmedCount = clampCount(readCount());\n  desiredCount = confirmedCount;\n  paintCount(confirmedCount);\n  watchField();\n  attachResetForms();\n  if (document.addEventListener) {\n    document.addEventListener('submit', onSubmitCapture, true);\n  }\n  var btns = document.querySelectorAll('.counter-wrap .counter-step');\n  for (var i = 0; i < btns.length; i++) {\n    (function (btn) {\n      if (btn && btn.addEventListener) {\n        btn.addEventListener('click', function () {\n          var d = parseInt(btn.getAttribute('data-delta') || '1', 10);\n          if (isNaN(d)) { d = 1; }\n          stepCounter(d, actionBase(btn));\n        });\n      }\n    })(btns[i]);\n  }\n}\nif (document.readyState === 'loading') {\n  if (document.addEventListener) { document.addEventListener('DOMContentLoaded', initCounter); }\n} else {\n  initCounter();\n}\n</script>\n</body>\n</html>\n"
    }
  },
  "ui": {
    "title": "Counter",
    "hideState": true,
    "actions": [
      {
        "action": "reset_count",
        "label": "Reset count"
      }
    ]
  },
  "stateSchema": {
    "type": "object",
    "initial": {
      "count": 0
    },
    "fields": {
      "count": {
        "type": "integer",
        "min": 0,
        "max": 1000000
      }
    }
  },
  "actions": {
    "set_count": {
      "description": "Set the counter to an explicit value.",
      "args": {
        "value": {
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 1000000
        }
      },
      "effects": [
        {
          "op": "set",
          "field": "count",
          "fromArg": "value"
        }
      ]
    },
    "reset_count": {
      "description": "Reset the counter to zero.",
      "effects": [
        {
          "op": "set",
          "field": "count",
          "value": 0
        }
      ]
    }
  }
}
