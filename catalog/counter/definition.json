          "min": 0,
          "max": 1000000
        }
      },
      "effects": [
        {
          "op": "set",
          "field": "count",
          "fromArg": "value"
        }
      ]
    },
    "reset_count": {
      "description": "Reset the counter to zero.",
      "effects": [
        {
          "op": "set",
          "field": "count",
