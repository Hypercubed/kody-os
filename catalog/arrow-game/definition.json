{
  "id": "arrow-game",
  "name": "Arrow Game",
  "label": "Arrow Game",
  "schemaVersion": 5,
  "catalogVersion": 5,
  "icon": "→",
  "category": "Games",
  "description": "A puzzle about clearing the blue arrows; a red arrow costs a life, and a new life arrives every five levels. A kody-os rewrite of Hypercubed/arrow-game on GitHub.",
  "bundle": {
    "entry": "index.html",
    "files": [
      "index.html"
    ]
  },
  "ui": {
    "title": "Arrow Game",
    "openAs": "page",
    "hideState": true,
    "actions": []
  },
  "stateSchema": {
    "type": "object",
    "initial": {
      "board": "U",
      "level": 1,
      "lives": 0,
      "removed": 0
    },
    "fields": {
      "board": {
        "type": "string",
        "maxLength": 4096
      },
      "level": {
        "type": "integer",
        "min": 1,
        "max": 10000
      },
      "lives": {
        "type": "integer",
        "min": 0,
        "max": 1000
      },
      "removed": {
        "type": "integer",
        "min": 0,
        "max": 1000000
      }
    }
  },
  "actions": {
    "save": {
      "description": "Save the whole game state (absolute set, bundle wins on rebase).",
      "args": {
        "board": {
          "type": "string",
          "required": true,
          "maxLength": 4096
        },
        "level": {
          "type": "integer",
          "required": true,
          "min": 1,
          "max": 10000
        },
        "lives": {
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 1000
        },
        "removed": {
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 1000000
        }
      },
      "effects": [
        {
          "op": "set",
          "field": "board",
          "fromArg": "board"
        },
        {
          "op": "set",
          "field": "level",
          "fromArg": "level"
        },
        {
          "op": "set",
          "field": "lives",
          "fromArg": "lives"
        },
        {
          "op": "set",
          "field": "removed",
          "fromArg": "removed"
        }
      ]
    }
  }
}
